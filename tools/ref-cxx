#!/bin/sh
# Compile and link against the toolchain's own standard library (libstdc++ 16) instead of
# libycxx: the reference runs of libycxx's own test suite (tests/ycxx/REFERENCE.md).
#   ref-cxx gcc|clang [compiler args...]
# Compilers: $YCXX_GXX / $YCXX_CLANGXX (tools/toolchain/activate.*), else g++-16 / clang++-23.
# Clang uses GCC 16's installation, so both compilers see the same libstdc++.
which=$1; shift
gxx=${YCXX_GXX:-g++-16}
# Run against GCC 16's libstdc++.so, not an older system copy.
libdir=$(dirname "$($gxx -print-file-name=libstdc++.so)")
rpath="-Wl,-rpath,$libdir"
case $which in
  gcc)   exec $gxx -std=c++26 "$@" $rpath ;;
  clang) gcc_install_dir=${YCXX_GCC_INSTALL_DIR:-$(dirname "$($gxx -print-libgcc-file-name)")}
         exec ${YCXX_CLANGXX:-clang++-23} --gcc-install-dir="$gcc_install_dir" -stdlib=libstdc++ -std=c++26 "$@" $rpath ;;
  *) echo "usage: ref-cxx gcc|clang args..." >&2; exit 2 ;;
esac
