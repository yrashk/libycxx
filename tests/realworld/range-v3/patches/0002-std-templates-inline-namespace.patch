Category: implementation-specific. range-v3 redeclares the primary templates std::common_type and
std::basic_common_reference in namespace std before specializing them, which names the library's
templates only where they are members of std itself (libstdc++, MSVC's library) or of the
namespace libc++'s macro opens. libycxx's are in its inline namespace std::__y1 (DECISIONS §20.4),
so the redeclarations declare other templates and the specializations become ambiguous. With
another library the patch leaves out the redeclarations and includes <type_traits>, which
declares both; the specializations in namespace std then specialize them ([namespace.def]/7).

diff --git a/include/range/v3/detail/config.hpp b/include/range/v3/detail/config.hpp
index f8015f4..0b52351 100644
--- a/include/range/v3/detail/config.hpp
+++ b/include/range/v3/detail/config.hpp
@@ -125,6 +125,15 @@ namespace ranges
 
 // Non-portable forward declarations of standard containers
 #define RANGES_BEGIN_NAMESPACE_STD META_BEGIN_NAMESPACE_STD
+// The primary templates std::common_type and std::basic_common_reference are redeclared before
+// they are specialized only with the libraries known to declare them directly in std; another
+// library's are found in <type_traits> (and may be in an inline namespace of std).
+#if defined(_LIBCPP_VERSION) || defined(__GLIBCXX__) || defined(_MSVC_STL_VERSION)
+#define RANGES_REDECLARE_STD_TEMPLATES 1
+#else
+#define RANGES_REDECLARE_STD_TEMPLATES 0
+#include <type_traits>
+#endif
 #define RANGES_END_NAMESPACE_STD META_END_NAMESPACE_STD
 #define RANGES_BEGIN_NAMESPACE_VERSION META_BEGIN_NAMESPACE_VERSION
 #define RANGES_END_NAMESPACE_VERSION META_END_NAMESPACE_VERSION
