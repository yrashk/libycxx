#!/bin/sh
# Compile and link against libycxx.
#   ycxx-cxx gcc|clang [--shared] [--libdir=DIR] [--std-modules[=DIR]] [compiler args...]
# Links build/<compiler>/libycxx.a and libycxx's own ABI runtime (build/<compiler>/libycxx-abi.a);
# stack unwinding comes from the toolchain's libgcc_s.
# --shared (or $YCXX_LINKAGE=shared): shared mode (DECISIONS §20): compiles with -DYCXX_SHARED and
# links the shared library and libycxx_nonshared.a of build/<compiler>-shared (a build configured
# with -DYCXX_SHARED=ON), with a run path to it.
# --libdir=DIR: the build of libycxx to use instead (its archives, generated headers and link
# options), e.g. an instrumented one, build/<compiler>-tsan (DECISIONS §6.8); $YCXX_LIBDIR
# does the same.
# --std-modules[=DIR]: `import std;` and `import std.compat;` use the modules tools/ycxx-modules
# built in DIR (default build/<compiler>/modules; shared mode: build/<compiler>-shared/modules), and
# a link includes their objects.
# $YCXX_CXX_LOG=DIR: also record each command this runs in DIR, one file per invocation (the
# working directory, then every argument, each ended by a NUL byte): the evidence tools/realworld
# checks that every translation unit and link of a project went through libycxx.
here=$(cd "$(dirname "$0")/.." && pwd)
which=$1; shift
# Compilers: $YCXX_GXX / $YCXX_CLANGXX (set by tools/toolchain/activate.*), else g++-16 / clang++-23.
gxx=${YCXX_GXX:-g++-16}
case $which in
  gcc)   cxx=$gxx ;;
  clang) cxx=${YCXX_CLANGXX:-clang++-23} ;;
  *) echo "usage: ycxx-cxx gcc|clang args..." >&2; exit 2 ;;
esac
# --std-modules[=DIR]: the flags tools/ycxx-modules recorded, and its archive when linking.
modules= libdir= linkage=${YCXX_LINKAGE:-static}
for a in "$@"; do
  shift
  case $a in
    --shared) linkage=shared ;;
    --static) linkage=static ;;
    --libdir=*) libdir=${a#--libdir=} ;;
    --std-modules) modules=default ;;
    --std-modules=*) modules=${a#--std-modules=} ;;
    *) set -- "$@" "$a" ;;
  esac
done
case $linkage in
  static) libdir=${libdir:-${YCXX_LIBDIR:-$here/build/$which}} mode_flags= ;;
  shared) libdir=${libdir:-${YCXX_LIBDIR:-$here/build/$which-shared}} mode_flags=-DYCXX_SHARED ;;
  *) echo "ycxx-cxx: YCXX_LINKAGE must be static or shared, not '$linkage'" >&2; exit 2 ;;
esac
[ "$modules" = default ] && modules=$here/build/$which/modules && [ $linkage = shared ] && modules=$here/build/$which-shared/modules
modules_flags= modules_lib=
if [ -n "$modules" ]; then
  if [ ! -f "$modules/flags" ]; then
    echo "ycxx-cxx: no modules built in $modules (run tools/ycxx-modules $which [-o DIR] [flags])" >&2
    exit 1
  fi
  modules_flags=$(cat "$modules/flags")
  modules_lib=$modules/libycxx-modules.a
fi
extra=
# Hidden visibility (DECISIONS §2): GCC's -Wattributes warning about program classes with a member
# or base of a library class type says nothing about the program (STATUS, known limitations).
[ $which = gcc ] && extra=-Wno-attributes
if [ "$(uname -s)" = Darwin ]; then
  # Apple's linker searches archives repeatedly by itself, and the C runtime comes from the SDK.
  # Unwinding is libSystem's unwinder for both compilers (GCC's Darwin specs link -lemutls_w and
  # libgcc with -static-libgcc, not an unwinder of their own), so there is one per process.
  group_begin= group_end= static_libgcc=
  [ $which = gcc ] && static_libgcc=-static-libgcc
  # libycxx's <atomic> needs no libatomic (DECISIONS §3), and Apple's SDK has none: drop
  # -latomic when the compiler cannot find one (Clang; Homebrew's GCC ships its own).
  case " $* " in
    *" -latomic "*)
      if [ "$($cxx -print-file-name=libatomic.dylib)" = libatomic.dylib ] &&
         [ "$($cxx -print-file-name=libatomic.a)" = libatomic.a ]; then
        for a in "$@"; do
          shift
          [ "$a" = -latomic ] || set -- "$@" "$a"
        done
      fi ;;
  esac
else
  # -shared-libgcc: one unwinder per process (glibc's pthread_exit/pthread_cancel unwind
  # through libgcc_s.so; a static libgcc_eh copy in the program would make them abort).
  group_begin=-Wl,--start-group group_end=-Wl,--end-group static_libgcc=-shared-libgcc
  # Run against GCC 16's libgcc_s (the one linked against), not an older system copy: as
  # tools/ref-cxx does for the reference runs (a newer unwinder is also faster).
  gcc_s=$($gxx -print-file-name=libgcc_s.so.1)
  [ "$gcc_s" != libgcc_s.so.1 ] && static_libgcc="$static_libgcc -Wl,-rpath,$(dirname "$gcc_s")"
  # Clang uses GCC 16's installation for the C runtime startup files and libgcc.
  if [ $which = clang ]; then
    gcc_install_dir=${YCXX_GCC_INSTALL_DIR:-$(dirname "$($gxx -print-libgcc-file-name)")}
    extra="--gcc-install-dir=$gcc_install_dir"
  fi
fi
abi="$libdir/libycxx-abi.a"
link=1
for a in "$@"; do case $a in -c|-S|-E|-fsyntax-only|-M|-MM|--precompile) link=0 ;; esac; done
if [ $link = 1 ]; then
  # The allocation table's link options, as the build found them (cmake/ycxx-link.cmake).
  table_opts=
  [ -f "$libdir/ycxx-link-options" ] && table_opts=$(cat "$libdir/ycxx-link-options")
  # ThreadSanitizer with Clang: no sanitizer C++ runtime. Clang links ThreadSanitizer's C++ part
  # (libclang_rt.tsan_cxx) whole, and it holds only strong definitions of the global allocation
  # functions: a program's replacement would be a second definition, and libycxx's defaults
  # (new_handler, bad_alloc) would be bypassed. Race detection does not need them: libycxx's
  # allocation functions call malloc, which the sanitizer intercepts (DECISIONS §6.8). GCC links
  # its shared libtsan.so, which defines them too, ahead of every input; a TSan build's link
  # options (ycxx-link-options) name libycxx's defaults' anchors, so the program's own win.
  if [ $which = clang ]; then
    for a in "$@"; do
      case $a in -fsanitize=*thread*) table_opts="$table_opts -fno-sanitize-link-c++-runtime"; break ;; esac
    done
  fi
  if [ $linkage = shared ]; then
    # The shared library through its development name (a symbolic link to the soname's file) and
    # the per-image archive, with a run path to the build.
    so=$libdir/libycxx.so
    [ "$(uname -s)" = Darwin ] && so=$libdir/libycxx.dylib
    libs="$so $libdir/libycxx_nonshared.a -Wl,-rpath,$libdir"
  else
    libs="$group_begin $libdir/libycxx.a $abi $group_end"
  fi
  set -- $cxx $extra -std=c++26 -nostdinc++ $mode_flags -isystem "$here/include" -isystem "$libdir/generated/include" $modules_flags "$@" \
    -nostdlib++ $table_opts $modules_lib $libs -lm $static_libgcc
else
  set -- $cxx $extra -std=c++26 -nostdinc++ $mode_flags -isystem "$here/include" -isystem "$libdir/generated/include" $modules_flags "$@"
fi
if [ -n "${YCXX_CXX_LOG:-}" ]; then
  log=$(mktemp "$YCXX_CXX_LOG/cmd.XXXXXXXX") || exit 1
  { printf '%s\0' "$PWD"; printf '%s\0' "$@"; } >"$log"
fi
exec "$@"
