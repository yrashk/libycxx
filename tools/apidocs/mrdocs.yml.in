# MrDocs configuration of libycxx's API reference; tools/gen-apidocs fills the @...@ fields.
source-root: @SOURCE_ROOT@
compilation-database: @COMPILATION_DATABASE@
generator: @GENERATOR@
output: @OUTPUT@
# libycxx's templates, layered over MrDocs's stock ones.
addons-supplemental:
  - @ADDONS@
multipage: true
concurrency: @JOBS@

# Never the system's C++ library, nor MrDocs's bundled libc++: the translation unit has
# -nostdinc++ and libycxx's include paths, and the C library is the system's (glibc).
use-system-stdlib: false
stdlib-includes:
  - @NO_STDLIB@
use-system-libc: true

# The public API is what the std module exports (modules/std.cppm), with the members of what
# it exports; nothing in libycxx's own namespaces. A namespace that holds customization point
# objects in an inline namespace (std::ranges::__cpo) is included whole, since MrDocs (2026.9.29)
# matches no literal pattern to its members; tools/apidocs/render.py then drops whatever
# the module does not export and every member with a reserved name.
include-symbols:
@INCLUDE_SYMBOLS@
# Internals that public declarations mention (base classes, the types of customization point
# objects and niebloids, exposition-only helpers) are kept for the cross-references but shown
# as the standard shows them: /* implementation-defined */.
implementation-defined:
  - '__ycxx::**'

overloads: true
extract-private: false
extract-private-bases: false
sort-members: true
# A variable whose type's only members are call operators is shown as the function it stands
# for ([algorithms.requirements]/2); for the others tools/gen-apidocs adds their call signatures.
auto-function-objects: true
auto-brief: false
warnings: false
