{{!-- The synopsis: one declaration, or an overload set numbered (1), (2)…
      Expected context: {Symbol Object} --}}
<section class="ref-sec syn" aria-labelledby="sec-syn">
{{#if (eq kind "overloads")}}
<h2 id="sec-syn">Overloads</h2>
<ol class="ovl">
{{#each members}}
<li class="ovl-item" id="overload-{{add @index 1}}"><div class="ovl-code"><pre class="cpp"><code>{{> symbol/signature/function . }}</code></pre></div><span class="ovl-n" aria-label="overload {{add @index 1}}">({{add @index 1}})</span></li>
{{/each}}
</ol>
{{else}}
<h2 id="sec-syn">Synopsis</h2>
<div class="syn-code"><pre class="cpp"><code>{{> symbol/signature . }}</code></pre></div>
{{/if}}
</section>
