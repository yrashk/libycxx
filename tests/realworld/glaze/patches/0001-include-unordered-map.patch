+++ b/include/glaze/file/read_directory.hpp
@@ -4,6 +4,7 @@
 #pragma once
 
 #include <filesystem>
+#include <unordered_map>
 
 #include "glaze/core/read.hpp"
 #include "glaze/file/file_ops.hpp"
