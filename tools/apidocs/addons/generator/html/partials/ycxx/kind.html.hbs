{{!-- The kind of a symbol, in the words the standard uses. Expected context: {Symbol Object} --}}
{{~#if (eq kind "namespace")}}namespace
{{~else if (eq kind "record")~}}
  {{~#if (eq template.kind "partial")}}{{> ycxx/class-key . }} template partial specialization
  {{~else if (eq template.kind "explicit")}}{{> ycxx/class-key . }} template specialization
  {{~else if template}}{{> ycxx/class-key . }} template
  {{~else}}{{> ycxx/class-key . }}{{/if~}}
  {{~#if (eq parent.kind "record")}} · nested{{/if~}}
{{~else if (eq kind "overloads")~}}
  {{~#with (front members)~}}{{> ycxx/kind-function . }}{{~/with}} · {{size members}} overloads
{{~else if (eq kind "function")}}{{> ycxx/kind-function . }}
{{~else if (eq kind "typedef")}}{{#if template}}alias template{{else}}type alias{{/if}}{{#if (eq parent.kind "record")}} · member type{{/if}}
{{~else if (eq kind "variable")~}}
  {{~#if (eq parent.kind "record")}}static data member{{else}}{{#if template}}variable template{{else}}{{#if (and isConstexpr type.name.symbol.isImplementationDefined)}}function object{{else if isConstexpr}}constant{{else}}variable{{/if}}{{/if}}{{/if~}}
{{~else if (eq kind "field")}}data member
{{~else if (eq kind "concept")}}concept
{{~else if (eq kind "enum")}}{{#if isScoped}}scoped enumeration{{else}}enumeration{{/if}}
{{~else if (eq kind "enum-constant")}}enumerator
{{~else if (eq kind "guide")}}deduction guide
{{~else if (eq kind "using")}}using-declaration
{{~else if (eq kind "namespace-alias")}}namespace alias
{{~else}}{{kind}}{{/if~}}
