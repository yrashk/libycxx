# libycxx: what the target's C library provides, found by asking it (DECISIONS §1, "Facts about
# the C library").
#
# The hosted C wrappers (<cstdlib>, <ctime>, <cuchar>, <cstdio>, generated by tools/gen_cheaders.py)
# either bring the C library's declaration into std or declare libycxx's own. Which one depends on
# the C library, and that knowledge is not written down anywhere in libycxx: this module compiles
# small probes against the C library's own headers (in C, so libycxx's headers are not involved)
# and writes the answers to <ycxx/generated/c_library.hpp> in the build tree, which `ycxx/config.hpp` includes
# when it is found (`__has_include`). The file is installed next to the headers and reaches
# tools/ycxx-cxx through the build directory.
#
# Without that file (the headers used without configuring libycxx) config.hpp assumes a C23 C
# library: every switch is 1, so a missing function shows up as a compile error naming it.
#
# Switches written (each 1 or 0):
#   _YCXX_C_HAS_STRFROM          <stdlib.h> declares strfromd, strfromf, strfroml (C23 7.24.1.3)
#   _YCXX_C_HAS_MBRTOC8          <uchar.h> declares mbrtoc8 and c8rtomb (C23 7.30.1)
#   _YCXX_C_HAS_TIMESPEC_GETRES  <time.h> declares timespec_getres (C23 7.29.2.7)
# and, when the C library's <stdio.h> lacks _PRINTF_NAN_LEN_MAX (C23 7.23.1):
#   _YCXX_C_PRINTF_NAN_LEN_MAX   the longest output of the C library's printf for a NaN with the
#                               conversions f F e E g G a A, measured by running a probe (signs,
#                               payloads, the + and space flags); not written when the probe cannot
#                               run (cross compilation), and <cstdio> then leaves the macro undefined.
#
# Facts the preprocessor can see are tested where they are used instead (#ifdef PRIb8,
# #ifndef _PRINTF_NAN_LEN_MAX, __has_include_next(<uchar.h>)).

include(CheckSymbolExists)

function(ycxx_c_library_probe out_file)
  set(CMAKE_REQUIRED_QUIET ON)
  set(CMAKE_REQUIRED_FLAGS -std=c2x)

  check_symbol_exists(strfromd stdlib.h _ycxx_strfromd)
  check_symbol_exists(strfromf stdlib.h _ycxx_strfromf)
  check_symbol_exists(strfroml stdlib.h _ycxx_strfroml)
  check_symbol_exists(mbrtoc8 uchar.h _ycxx_mbrtoc8)
  check_symbol_exists(c8rtomb uchar.h _ycxx_c8rtomb)
  check_symbol_exists(timespec_getres time.h _ycxx_timespec_getres)
  check_symbol_exists(_PRINTF_NAN_LEN_MAX stdio.h _ycxx_has_printf_nan_len_max)

  set(strfrom 0)
  if(_ycxx_strfromd AND _ycxx_strfromf AND _ycxx_strfroml)
    set(strfrom 1)
  endif()
  set(mbrtoc8 0)
  if(_ycxx_mbrtoc8 AND _ycxx_c8rtomb)
    set(mbrtoc8 1)
  endif()
  set(getres 0)
  if(_ycxx_timespec_getres)
    set(getres 1)
  endif()

  set(nan_line "// _PRINTF_NAN_LEN_MAX: the C library defines it.")
  if(NOT _ycxx_has_printf_nan_len_max)
    set(nan_line "// _PRINTF_NAN_LEN_MAX: not measured (the probe could not run).")
    if(NOT CMAKE_CROSSCOMPILING)
      set(probe ${CMAKE_CURRENT_BINARY_DIR}/c_library_probe/printf_nan.c)
      file(WRITE ${probe} [=[
#include <math.h>
#include <stdio.h>
#include <string.h>
#include <stdint.h>
int main(void) {
  static const char* const conv[] = {"f", "F", "e", "E", "g", "G", "a", "A"};
  static const char* const flags[] = {"", "+", " "};
  double values[8];
  int n = 0;
  values[n++] = NAN;
  values[n++] = -NAN;
  uint64_t bits[] = {0x7ff8000000000001u, 0x7fffffffffffffffu, 0xfff8000000000001u,
                     0xffffffffffffffffu, 0x7ff0000000000001u, 0xfff0000000000001u};
  for (int i = 0; i < 6; ++i)
    memcpy(&values[n++], &bits[i], sizeof(double));
  size_t longest = 0;
  for (int v = 0; v < n; ++v)
    for (int c = 0; c < 8; ++c)
      for (int f = 0; f < 3; ++f) {
        char fmt[8], buf[512];
        snprintf(fmt, sizeof fmt, "%%%s%s", flags[f], conv[c]);
        int len = snprintf(buf, sizeof buf, fmt, values[v]);
        if (len > 0 && (size_t)len > longest)
          longest = (size_t)len;
      }
  printf("%zu", longest);
  return 0;
}
]=])
      try_run(_ycxx_nan_run _ycxx_nan_compile SOURCES ${probe}
              COMPILE_DEFINITIONS -std=c2x RUN_OUTPUT_VARIABLE _ycxx_nan_len)
      if(_ycxx_nan_compile AND _ycxx_nan_run EQUAL 0 AND _ycxx_nan_len MATCHES "^[0-9]+$")
        set(nan_line "#define _YCXX_C_PRINTF_NAN_LEN_MAX ${_ycxx_nan_len}")
      endif()
    endif()
  endif()

  file(CONFIGURE OUTPUT ${out_file} CONTENT [=[
// Generated by cmake/ycxx-c-library.cmake: what this target's C library provides, found by
// compiling probes against it. Included by ycxx/config.hpp.
#pragma once

#define _YCXX_C_HAS_STRFROM @strfrom@
#define _YCXX_C_HAS_MBRTOC8 @mbrtoc8@
#define _YCXX_C_HAS_TIMESPEC_GETRES @getres@
@nan_line@
]=] @ONLY)
  message(STATUS "libycxx: C library: strfrom* ${strfrom}, mbrtoc8 ${mbrtoc8}, timespec_getres ${getres}; ${nan_line}")
endfunction()
