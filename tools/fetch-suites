#!/bin/sh
# Fetches the external conformance suites libycxx is run against (run only; their tests are
# never copied into this repository):
#   libc++'s tests    llvm-project at llvmorg-$YCXX_LLVM_VERSION (default 23.1.2): libcxx/test/std
#                     and libcxx/test/support only (a sparse, shallow git checkout)
#   libstdc++'s tests gcc-$YCXX_GCC_VERSION (default 16.2.0): libstdc++-v3/testsuite only, taken
#                     out of the release tarball as it streams in; no library source is unpacked
# into $YCXX_SUITES (default ~/.local/share/ycxx/suites), where tools/run-conformance and
# tools/test find them (tools/lib/env.sh). Linux and macOS; needs git, curl or wget, tar and xz.
#
#   tools/fetch-suites [--libcxx-only | --libstdcxx-only] [--force]
set -eu
repo=$(cd "$(dirname "$0")/.." && pwd)
. "$repo/tools/lib/ui.sh"
. "$repo/tools/lib/env.sh"

llvm=${YCXX_LLVM_VERSION:-23.1.2}
gcc=${YCXX_GCC_VERSION:-16.2.0}
cache=$(ycxx_suites_cache)
want_libcxx=1 want_libstdcxx=1 force=0
for a in "$@"; do
  case $a in
    --libcxx-only) want_libstdcxx=0 ;;
    --libstdcxx-only) want_libcxx=0 ;;
    --force) force=1 ;;
    -h|--help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "tools/fetch-suites: unknown option '$a'" >&2; exit 2 ;;
  esac
done
mkdir -p "$cache"
logs=$repo/build/test-logs
mkdir -p "$logs"
fail=0

ui_title "External conformance suites into ${cache}"

if [ $want_libcxx = 1 ]; then
  ui_section "libc++ tests (LLVM ${llvm})"
  d=$cache/llvm-project
  if [ -d "$d/libcxx/test/std" ] && [ $force = 0 ] &&
     [ "$(git -C "$d" describe --tags --exact-match 2>/dev/null)" = "llvmorg-${llvm}" ]; then
    ui_ok "already there" "($d/libcxx/test)"
  else
    rm -rf "$d"
    if ui_step "clone llvmorg-${llvm} (sparse: libcxx/test/std, libcxx/test/support)" "$logs/fetch-libcxx.log" \
         git clone --quiet --depth 1 --branch "llvmorg-${llvm}" --filter=blob:none --sparse \
           https://github.com/llvm/llvm-project.git "$d" &&
       ui_step "check out the test directories" "$logs/fetch-libcxx-sparse.log" \
         git -C "$d" sparse-checkout set libcxx/test/std libcxx/test/support; then
      ui_ok "libc++ tests" "($d/libcxx/test)"
    else
      fail=1
    fi
  fi
fi

if [ $want_libstdcxx = 1 ]; then
  ui_section "libstdc++ testsuite (GCC ${gcc})"
  d=$cache/libstdcxx-testsuite
  if [ -d "$d" ] && [ -f "$d/.ycxx-gcc-version" ] && [ "$(cat "$d/.ycxx-gcc-version")" = "$gcc" ] && [ $force = 0 ]; then
    ui_ok "already there" "($d)"
  else
    rm -rf "$d" "$cache/gcc-${gcc}"
    # The GNU site, then GCC's own release directory (a mirror of it), should one be unreachable
    # (CI has seen ftp.gnu.org refuse connections for minutes): each is tried in turn, with a short
    # connection timeout so that an unreachable one fails fast.
    urls="https://ftp.gnu.org/gnu/gcc/gcc-${gcc}/gcc-${gcc}.tar.xz https://gcc.gnu.org/pub/gcc/releases/gcc-${gcc}/gcc-${gcc}.tar.xz"
    if command -v curl >/dev/null 2>&1; then get="curl -fsSL --connect-timeout 20 --retry 2"; else get="wget -qO- --timeout=20 --tries=2"; fi
    # Only the testsuite leaves the stream: the member pattern selects it (GNU tar and bsdtar).
    if ui_step "download gcc-${gcc}.tar.xz, extract libstdc++-v3/testsuite" "$logs/fetch-libstdcxx.log" \
         sh -c "for u in $urls; do echo \"from \$u\"; rm -rf '$cache/gcc-${gcc}';
                  if $get \"\$u\" | tar -xJf - -C '$cache' 'gcc-${gcc}/libstdc++-v3/testsuite'; then exit 0; fi
                done; exit 1"; then
      mv "$cache/gcc-${gcc}/libstdc++-v3/testsuite" "$d"
      rm -rf "$cache/gcc-${gcc}"
      echo "$gcc" >"$d/.ycxx-gcc-version"
      ui_ok "libstdc++ testsuite" "($d)"
    else
      fail=1
    fi
  fi
fi

echo
if [ $fail = 0 ]; then ui_ok "done: tools/test libcxx libstdcxx (or all) now runs them"
else ui_fail "some suites could not be fetched (logs in $logs)"; fi
exit $fail
