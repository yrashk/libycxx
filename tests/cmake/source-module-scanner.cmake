cmake_minimum_required(VERSION 3.28)

if(NOT CXX OR NOT WORK_DIR)
  message(FATAL_ERROR "Run with -DCXX=<clang++> -DWORK_DIR=<scratch directory>")
endif()
cmake_path(ABSOLUTE_PATH WORK_DIR)
cmake_path(SET _lib NORMALIZE "${CMAKE_CURRENT_LIST_DIR}/../..")
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef _nonce)
set(_run "${WORK_DIR}/${_nonce}")
set(_source "${_run}/source")
set(_scanner "${_run}/absent-clang-scan-deps")
file(MAKE_DIRECTORY "${_source}/library/cmake")
file(COPY_FILE "${_lib}/cmake/ycxx-lower-module-unit.cmake" "${_source}/library/cmake/ycxx-lower-module-unit.cmake")
file(WRITE "${_source}/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.28)
project(parent LANGUAGES CXX)
if(DEFINED PARENT_MODE)
  set(YCXX_SOURCE_MODULES "${PARENT_MODE}")
endif()
add_subdirectory(library)
]=])
file(WRITE "${_source}/library/CMakeLists.txt" [=[
project(scanner_fixture LANGUAGES CXX)
set(CMAKE_CXX_SCAN_FOR_MODULES OFF)
option(YCXX_MODULES "Public modules" ON)
include("${LIBYCXX_SOURCE}/cmake/ycxx-source-modules.cmake")
add_library(probe STATIC src/witness.cppm)
target_include_directories(probe PRIVATE "${LIBYCXX_SOURCE}/include")
target_compile_options(probe PRIVATE -std=c++26 -nostdinc++)
ycxx_add_module_units(probe SOURCES src/witness.cppm)
file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/module-sets.txt" CONTENT "$<TARGET_PROPERTY:probe,CXX_MODULE_SETS>")
]=])
file(WRITE "${_source}/library/src/witness.cppm" [=[
module;
#include <ycxx/core/hidden_symbol.hpp>
export module ycxx.witness;
asm((::__ycxx::__detail::__hide_symbol("_ZGIW4ycxxW7witness")));
extern "C" int witness() { return 1; }
]=])

function(_configure build generator public expected)
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${_source}" -B "${build}" -G "${generator}"
                  "-DCMAKE_CXX_COMPILER=${CXX}" "-DCMAKE_CXX_COMPILER_CLANG_SCAN_DEPS=${_scanner}"
                  "-DLIBYCXX_SOURCE=${_lib}" "-DYCXX_MODULES=${public}" ${ARGN}
                  RESULT_VARIABLE _status OUTPUT_VARIABLE _log ERROR_VARIABLE _log)
  if(expected STREQUAL "reject")
    if(_status EQUAL 0 OR NOT _log MATCHES "YCXX_SOURCE_MODULES=ON needs a Ninja generator")
      message(FATAL_ERROR "Non-Ninja configure did not reject explicit ON\n${_log}")
    endif()
    return()
  endif()
  if(NOT _status EQUAL 0)
    message(FATAL_ERROR "Configure failed in ${build}\n${_log}")
  endif()
  file(READ "${build}/module-sets.txt" _sets)
  if(expected STREQUAL "native" AND NOT _sets STREQUAL "ycxx_module_units")
    message(FATAL_ERROR "Expected a native module file set in ${build}, found '${_sets}'")
  elseif(expected STREQUAL "plain" AND NOT _sets STREQUAL "")
    message(FATAL_ERROR "Expected lowered sources in ${build}, found module file sets '${_sets}'")
  endif()
endfunction()

function(_build build expected)
  execute_process(COMMAND "${CMAKE_COMMAND}" --build "${build}" --parallel 1 --target probe
                  RESULT_VARIABLE _status OUTPUT_VARIABLE _log ERROR_VARIABLE _log)
  if(expected STREQUAL "native")
    if(_status EQUAL 0 OR NOT _log MATCHES "absent-clang-scan-deps")
      message(FATAL_ERROR "Native build did not report its missing scanner in ${build}\n${_log}")
    endif()
  elseif(NOT _status EQUAL 0)
    message(FATAL_ERROR "Lowered build failed in ${build}\n${_log}")
  endif()
endfunction()

function(_cached_mode build expected)
  file(STRINGS "${build}/CMakeCache.txt" _entry REGEX "^YCXX_SOURCE_MODULES:")
  if(NOT _entry STREQUAL "YCXX_SOURCE_MODULES:STRING=${expected}")
    message(FATAL_ERROR "Expected cached ${expected} in ${build}, found '${_entry}'")
  endif()
endfunction()

set(_auto "${_run}/auto")
_configure("${_auto}" Ninja OFF plain)
_cached_mode("${_auto}" AUTO)
_build("${_auto}" plain)
_configure("${_auto}" Ninja ON native)
_build("${_auto}" native)
_configure("${_auto}" Ninja OFF plain)
_cached_mode("${_auto}" AUTO)
_build("${_auto}" plain)

set(_on "${_run}/explicit-on")
_configure("${_on}" Ninja OFF native -DYCXX_SOURCE_MODULES:BOOL=ON)
_cached_mode("${_on}" ON)
_build("${_on}" native)
_configure("${_on}" Ninja ON native)
_configure("${_on}" Ninja ON plain -DPARENT_MODE=OFF)
_cached_mode("${_on}" ON)
_build("${_on}" plain)

set(_off "${_run}/explicit-off")
_configure("${_off}" Ninja ON plain -DYCXX_SOURCE_MODULES:BOOL=OFF)
_cached_mode("${_off}" OFF)
_build("${_off}" plain)
_configure("${_off}" Ninja OFF plain)
_configure("${_off}" Ninja OFF native -DPARENT_MODE=ON)
_cached_mode("${_off}" OFF)

find_program(_make NAMES make gmake)
if(_make)
  set(_make_build "${_run}/makefiles")
  _configure("${_make_build}" "Unix Makefiles" OFF plain)
  _build("${_make_build}" plain)
  _configure("${_make_build}" "Unix Makefiles" OFF reject -DYCXX_SOURCE_MODULES=ON)
endif()

message(STATUS "AUTO followed public modules across reconfiguration, and explicit settings selected the requested mode")
file(REMOVE_RECURSE "${_run}")
