#!/usr/bin/env python3
"""Build and run libycxx's benchmarks against libycxx and against the toolchain's libstdc++.

    bench/run [--cc gcc,clang] [--md] [--samples N] [--only prog,...] [filter ...]

Every bench/*.cpp is compiled with -O2 -DNDEBUG twice per compiler: with tools/ycxx-cxx
(linking the Release library in build/<cc>-release, which this script builds or updates) and with
tools/ref-cxx (libstdc++). Both programs run in turn and the table shows ns/op for each and the
ratio libycxx/libstdc++ (above 1: libycxx is slower). Benchmarks are manual; nothing in CI runs
them. Filters are substrings of benchmark names, passed to the programs.
"""
import argparse
import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
BENCH = ROOT / "bench"
COMPILERS = {"gcc": ("gcc-16", "g++-16"), "clang": ("clang-23", "clang++-23")}
FLAGS = ["-O2", "-DNDEBUG"]


def sh(cmd, **kw):
    r = subprocess.run(cmd, **kw)
    if r.returncode:
        sys.exit(f"failed: {' '.join(map(str, cmd))}")
    return r


def build_library(cc):
    d = ROOT / "build" / f"{cc}-release"
    c, cxx = COMPILERS[cc]
    c = os.environ.get("YCXX_GCC" if cc == "gcc" else "YCXX_CLANG", c)
    cxx = os.environ.get("YCXX_GXX" if cc == "gcc" else "YCXX_CLANGXX", cxx)
    if not (d / "build.ninja").exists():
        sh(["cmake", "-S", ROOT, "-B", d, "-G", "Ninja", f"-DCMAKE_C_COMPILER={c}",
            f"-DCMAKE_CXX_COMPILER={cxx}", "-DCMAKE_BUILD_TYPE=Release"], stdout=subprocess.DEVNULL)
    sh(["ninja", "-C", d], stdout=subprocess.DEVNULL)
    return d


def run_program(exe, filters, env):
    out = subprocess.run([exe, *filters], capture_output=True, text=True, env=env)
    if out.returncode:
        sys.exit(f"{exe} failed:\n{out.stderr}")
    res = {}
    for line in out.stdout.splitlines():
        name, _, val = line.rpartition("\t")
        if name:
            res[name] = float(val)
    return res


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--cc", default="gcc,clang")
    ap.add_argument("--md", action="store_true", help="print a Markdown table")
    ap.add_argument("--samples", type=int, default=9)
    ap.add_argument("--only", default="", help="comma-separated program names (bench/<name>.cpp)")
    ap.add_argument("filters", nargs="*")
    a = ap.parse_args()
    ccs = [c for c in a.cc.split(",") if c]
    progs = sorted(p.stem for p in BENCH.glob("*.cpp"))
    if a.only:
        progs = [p for p in progs if p in a.only.split(",")]
    env = dict(os.environ, BENCH_SAMPLES=str(a.samples))

    results = {}  # (prog, name) -> {cc: (ycxx, std)}
    order = []
    for cc in ccs:
        libdir = build_library(cc)
        out = ROOT / "build" / "bench" / cc
        out.mkdir(parents=True, exist_ok=True)
        for prog in progs:
            src = BENCH / f"{prog}.cpp"
            exes = {}
            for lib, tool in (("ycxx", "ycxx-cxx"), ("std", "ref-cxx")):
                exe = out / f"{prog}-{lib}"
                if not exe.exists() or exe.stat().st_mtime < max(
                        src.stat().st_mtime, (BENCH / "bench.hpp").stat().st_mtime,
                        *(f.stat().st_mtime for f in libdir.glob("*.a") if lib == "ycxx")):
                    print(f"[{cc}] building {prog} ({lib})", file=sys.stderr)
                    sh([ROOT / "tools" / tool, cc, *FLAGS, src, "-o", exe],
                       env=dict(os.environ, YCXX_LIBDIR=str(libdir)))
                exes[lib] = exe
            print(f"[{cc}] running {prog}", file=sys.stderr)
            ry = run_program(exes["ycxx"], a.filters, env)
            rs = run_program(exes["std"], a.filters, env)
            for name, t in ry.items():
                key = (prog, name)
                if key not in results:
                    results[key] = {}
                    order.append(key)
                results[key][cc] = (t, rs.get(name, float("nan")))

    def ratio(p):
        y, s = p
        return y / s if s > 0 else float("nan")

    if a.md:
        head = "| benchmark | " + " | ".join(
            f"{cc} libycxx ns | {cc} libstdc++ ns | {cc} ratio" for cc in ccs) + " |"
        print(head)
        print("|---|" + "---:|" * (3 * len(ccs)))
        for key in order:
            cells = []
            for cc in ccs:
                if cc in results[key]:
                    y, s = results[key][cc]
                    r = ratio((y, s))
                    mark = "**" if r > 1.5 else ""
                    cells += [f"{y:.2f}", f"{s:.2f}", f"{mark}{r:.2f}{mark}"]
                else:
                    cells += ["", "", ""]
            print(f"| {key[0]}: {key[1]} | " + " | ".join(cells) + " |")
    else:
        w = max(len(f"{p}: {n}") for p, n in order) if order else 10
        print(f"{'benchmark':<{w}}" + "".join(
            f" | {cc + ' ycxx':>11} {cc + ' std':>11} {'ratio':>6}" for cc in ccs))
        for key in order:
            line = f"{key[0] + ': ' + key[1]:<{w}}"
            for cc in ccs:
                if cc in results[key]:
                    y, s = results[key][cc]
                    r = ratio((y, s))
                    line += f" | {y:11.2f} {s:11.2f} {r:5.2f}{'!' if r > 1.5 else ' '}"
                else:
                    line += " | " + " " * 30
            print(line)


if __name__ == "__main__":
    main()
