// -*- C++ -*-  libycxx: <initializer_list>   [core]
#pragma once

#include <ycxx/config.hpp>
#include <ycxx/core/cstddef.hpp>
#include <ycxx/core/version.hpp>

namespace std {

// Layout {pointer, size} is what both GCC and Clang construct for braced-init-lists.
template <class E>
class initializer_list {
  const E* first_;
  size_t size_;

  // Called by the compiler.
  constexpr initializer_list(const E* b, size_t n) noexcept : first_(b), size_(n) {}

public:
  using value_type = E;
  using reference = const E&;
  using const_reference = const E&;
  using size_type = size_t;
  using iterator = const E*;
  using const_iterator = const E*;

  constexpr initializer_list() noexcept : first_(nullptr), size_(0) {}

  constexpr const E* data() const noexcept { return first_; }
  constexpr size_t size() const noexcept { return size_; }
  constexpr const E* begin() const noexcept { return first_; }
  constexpr const E* end() const noexcept { return first_ + size_; }
  [[nodiscard]] constexpr bool empty() const noexcept { return size_ == 0; }
};

} // namespace std

