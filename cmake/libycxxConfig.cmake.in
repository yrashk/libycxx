# libycxx package configuration: find_package(libycxx CONFIG) provides
#   ycxx::ycxx     link this into every C++ target (headers, libycxx, its ABI runtime)
#   ycxx::headers  the headers only (-nostdinc++ and C++26 included)
#   ycxx::core     libycxx.a
#   ycxx::abi      libycxx-abi.a, the Itanium C++ ABI runtime
@PACKAGE_INIT@

set(libycxx_BUILT_WITH_COMPILER_ID "@CMAKE_CXX_COMPILER_ID@")
set(libycxx_BUILT_WITH_COMPILER_VERSION "@CMAKE_CXX_COMPILER_VERSION@")

# The consumer's C++ compiler must itself support libycxx's headers.
if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU" AND CMAKE_CXX_COMPILER_VERSION VERSION_LESS 16.2)
  set(_ycxx_bad TRUE)
elseif(CMAKE_CXX_COMPILER_ID STREQUAL "Clang" AND CMAKE_CXX_COMPILER_VERSION VERSION_LESS 23)
  set(_ycxx_bad TRUE)
elseif(CMAKE_CXX_COMPILER_ID AND NOT CMAKE_CXX_COMPILER_ID MATCHES "^(GNU|Clang)$")
  set(_ycxx_bad TRUE)
endif()
if(_ycxx_bad)
  set(libycxx_FOUND FALSE)
  set(libycxx_NOT_FOUND_MESSAGE
      "libycxx needs GCC >= 16.2 or Clang >= 23; this project uses ${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}")
  unset(_ycxx_bad)
  return()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/libycxxTargets.cmake")

# Linux, Clang: the C runtime startup files and libgcc come from GCC 16's installation, not
# Clang's default choice of GCC (which can be older), as with tools/ycxx-cxx and the toolchain
# file. The directory: the consumer's YCXX_GCC_INSTALL_DIR (CMake or environment variable), else
# the one recorded when libycxx was built; nothing when CMAKE_CXX_FLAGS already has one.
set(_ycxx_gcc_dir "@YCXX_GCC_INSTALL_DIR@")
if(DEFINED YCXX_GCC_INSTALL_DIR)
  set(_ycxx_gcc_dir "${YCXX_GCC_INSTALL_DIR}")
elseif(DEFINED ENV{YCXX_GCC_INSTALL_DIR})
  set(_ycxx_gcc_dir "$ENV{YCXX_GCC_INSTALL_DIR}")
endif()
get_target_property(_ycxx_opts ycxx::ycxx INTERFACE_LINK_OPTIONS) # once, if found again
if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_CXX_COMPILER_ID STREQUAL "Clang" AND
   _ycxx_gcc_dir AND IS_DIRECTORY "${_ycxx_gcc_dir}" AND NOT CMAKE_CXX_FLAGS MATCHES "--gcc-install-dir=" AND
   NOT "${_ycxx_opts}" MATCHES "--gcc-install-dir=")
  set_property(TARGET ycxx::ycxx APPEND PROPERTY INTERFACE_COMPILE_OPTIONS
               "$<$<COMPILE_LANG_AND_ID:CXX,Clang>:--gcc-install-dir=${_ycxx_gcc_dir}>")
  set_property(TARGET ycxx::ycxx APPEND PROPERTY INTERFACE_LINK_OPTIONS
               "$<$<AND:$<LINK_LANGUAGE:CXX>,$<CXX_COMPILER_ID:Clang>>:--gcc-install-dir=${_ycxx_gcc_dir}>")
endif()
unset(_ycxx_gcc_dir)
unset(_ycxx_opts)
check_required_components(libycxx)
