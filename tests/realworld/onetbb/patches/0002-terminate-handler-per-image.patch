+#if (!_MSC_VER || (defined(_DLL) && !defined(_DEBUG))) && !EMSCRIPTEN && (_MSC_VER || __GLIBCXX__ || _LIBCPP_VERSION) // a C++ runtime shared by the program and libtbb
