#!/bin/sh
# Generates the named locales libc++'s and libstdc++'s test suites require (glibc's localedef; run
# as root, e.g. in CI's Linux container after `apt-get install locales`). The suites check each
# name with the C library (tests/ycxxlit/locales.py) and report the tests that need a missing
# one UNSUPPORTED, so generating fewer is safe. Names without a charset get glibc's default for
# them, ISO-8859-1.
#   tools/ci/gen-locales            every name below
#   tools/ci/gen-locales NAME...    those names
set -u
if [ $# -eq 0 ]; then
  set -- aa_DJ.UTF-8 ar_SA.UTF-8 az_IR.UTF-8 ca_AD.UTF-8 cs_CZ.ISO8859-2 de_DE de_DE.ISO8859-1 \
    de_DE.ISO8859-15 de_DE.UTF-8 en_GB.ISO8859-1 en_HK.ISO8859-1 en_PH en_PH.ISO8859-1 \
    en_US.ISO-8859-15 en_US.ISO8859-1 en_US.ISO8859-15 en_US.UTF-8 es_ES.ISO8859-1 \
    es_ES.ISO8859-15 es_MX es_MX.ISO8859-1 fr_CA.ISO8859-1 fr_FR fr_FR.ISO8859-1 \
    fr_FR.ISO8859-15 fr_FR.UTF-8 is_IS.ISO8859-1 is_IS.UTF-8 it_IT it_IT.ISO8859-15 ja_JP.eucJP \
    ja_JP.UTF-8 my_MM.UTF-8 pt_PT.ISO8859-15 ru_RU.ISO8859-5 ru_RU.UTF-8 se_NO.UTF-8 ta_IN.UTF-8 \
    zh_CN.UTF-8 zh_TW.UTF-8
fi
made=0 failed=0
for name in "$@"; do
  base=${name%%.*}
  case $name in
    *.*) cs=${name#*.} ;;
    *) cs=ISO-8859-1 ;;
  esac
  case $cs in
    ISO8859-*) cs="ISO-8859-${cs#ISO8859-}" ;;
    eucJP) cs=EUC-JP ;;
  esac
  if localedef -i "${base}" -f "${cs}" "${name}" 2>/dev/null; then
    made=$((made + 1))
  else
    failed=$((failed + 1))
    echo "gen-locales: ${name} (${base}, ${cs}) could not be generated" >&2
  fi
done
echo "gen-locales: ${made} generated, ${failed} not"
