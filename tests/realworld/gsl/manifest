# Microsoft GSL: span, not_null, narrow: the guidelines support library, with GoogleTest.
url = https://github.com/microsoft/GSL.git
ref = v5.0.1
commit = fbd20b8e8c52cba04dbc869cc9068a7800a5665d
exercises = span, contracts, exceptions, iterators
deps = googletest
# Its tests find GoogleTest with pkg-config and use only the libraries it names, relying on the
# headers being in a default include directory: libycxx's build of GoogleTest is in the prefix.
configure = -DGSL_TEST=ON -DGSL_CXX_STANDARD=20 -DCMAKE_CXX_FLAGS=-I@PREFIX@/include
