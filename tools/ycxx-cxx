#!/bin/sh
# Compile and link against libycxx.
#   ycxx-cxx gcc|clang [compiler args...]
# Links build/<compiler>/libycxx.a and libycxx's own ABI runtime (build/<compiler>/libycxx-abi.a);
# stack unwinding comes from the toolchain's libgcc_eh.
here=$(cd "$(dirname "$0")/.." && pwd)
which=$1; shift
# Compilers: $YCXX_GXX / $YCXX_CLANGXX (set by tools/toolchain/activate.*), else g++-16 / clang++-23.
# Clang uses GCC 16's installation for the C runtime startup files and libgcc.
gxx=${YCXX_GXX:-g++-16}
gcc_install_dir=${YCXX_GCC_INSTALL_DIR:-$(dirname "$($gxx -print-libgcc-file-name)")}
case $which in
  gcc)   cxx=$gxx; extra="" ;;
  clang) cxx=${YCXX_CLANGXX:-clang++-23}; extra="--gcc-install-dir=$gcc_install_dir" ;;
  *) echo "usage: ycxx-cxx gcc|clang args..." >&2; exit 2 ;;
esac
abi="$here/build/$which/libycxx-abi.a"
link=1
for a in "$@"; do case $a in -c|-S|-E|-fsyntax-only|-M|-MM) link=0 ;; esac; done
if [ $link = 1 ]; then
  exec $cxx $extra -std=c++26 -nostdinc++ -isystem "$here/include" "$@" \
    -nostdlib++ -Wl,--start-group "$here/build/$which/libycxx.a" "$abi" -Wl,--end-group -static-libgcc
else
  exec $cxx $extra -std=c++26 -nostdinc++ -isystem "$here/include" "$@"
fi
