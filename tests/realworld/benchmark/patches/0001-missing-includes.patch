Category: transitive-include. sysinfo.cc calls std::tolower(char) without including <cctype>
(libstdc++ declares it through <locale> and <iostream>), benchmark_runner.cc uses errno without
<cerrno> (declared through <condition_variable>/<thread>, which include <system_error> there).
Adds the includes.

diff --git a/src/benchmark_runner.cc b/src/benchmark_runner.cc
index fb68867..dbe4acb 100644
--- a/src/benchmark_runner.cc
+++ b/src/benchmark_runner.cc
@@ -28,6 +28,7 @@
 
 #include <algorithm>
 #include <atomic>
+#include <cerrno>
 #include <climits>
 #include <cmath>
 #include <condition_variable>
diff --git a/src/sysinfo.cc b/src/sysinfo.cc
index 3977772..e991d22 100644
--- a/src/sysinfo.cc
+++ b/src/sysinfo.cc
@@ -61,6 +61,7 @@
 #include <algorithm>
 #include <array>
 #include <bitset>
+#include <cctype>
 #include <cerrno>
 #include <climits>
 #include <cstdint>
