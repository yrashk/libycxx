#!/bin/sh
# Run a conformance suite against libycxx.
#   tools/run-conformance libcxx|libstdcxx|ycxx gcc|clang [subdirs...] [-- extra lit args]
# Rebuilds build/<compiler> first (ninja) when it is a CMake build. Lists every test as it
# finishes with its result and the steps it ran ("compile exit 0 0.21s · run exit 0 0.00s"),
# failures with their transcript (the commands, exit statuses and output), under a live status
# line (counts, elapsed time, ETA), then lit's summary. Writes, as build/test-logs/<run>.*
# (<run> = <suite>-<compiler>[-<sanitizer>][-hardened][-<config name>][-ref]): .log, lit's complete output, every test's
# transcript included; .console.log, what the terminal showed; .html, a report of every test with its transcript and how the run was
# made (commit, compiler version, command), with copy buttons that put Markdown on the
# clipboard; .md, the whole report as Markdown (also embedded in the .html); .tsv, one line per
# test; .json, lit's results.
# Environment: LIBCXX_TESTS, LIBSTDCXX_TESTS (default: /opt/src, else the cache that
#              tools/fetch-suites fills; tools/lib/env.sh), SANITIZER (asan,ubsan),
#              YCXX_STDLIB=libstdcxx (ycxx suite only: build against libstdc++ instead, the
#              reference runs documented in tests/ycxx/REFERENCE.md),
#              YCXX_LIT / YCXX_LIT_VERSION (how lit runs: tools/lib/env.sh; by default through uvx),
#              YCXX_QUIET=1 (list only the tests that did not pass), YCXX_VERBOSE=1 (print every
#              test's whole transcript), YCXX_FAIL_DETAILS=N (show the transcript of the first N
#              failures, default 10), YCXX_RAW=1 (lit's own output, unfiltered),
#              YCXX_COLOR=always|never|auto, NO_COLOR,
#              Own suite only: YCXX_HARDENED=1 (compile the tests with -DYCXX_HARDENED=1, the
#              library's run-time precondition checks; runs the death tests of precondition/),
#              YCXX_CXXFLAGS="<flags>" (appended to every test's compile flags) with
#              YCXX_CONFIG_NAME=<short name> (the run's name for them; default: made from the
#              flags). Each configuration has its own logs.
set -e
repo=$(cd "$(dirname "$0")/.." && pwd)
. "$repo/tools/lib/ui.sh"
. "$repo/tools/lib/env.sh"
if [ $# -lt 2 ]; then
  echo "usage: tools/run-conformance libcxx|libstdcxx|ycxx gcc|clang [subdirs...] [-- lit args]" >&2
  exit 2
fi
suite=$1; compiler=$2; shift 2
ycxx_suite_dirs
case $suite in
  libcxx)    tests=$ycxx_libcxx_tests ;;
  libstdcxx) tests=$ycxx_libstdcxx_tests ;;
  ycxx)      tests=$repo/tests/ycxx ;;
  *) echo "unknown suite $suite" >&2; exit 2 ;;
esac
case $compiler in gcc|clang) ;; *) echo "unknown compiler $compiler" >&2; exit 2 ;; esac
if [ "$suite" != ycxx ] && { [ -n "${YCXX_CXXFLAGS:-}${YCXX_CONFIG_NAME:-}" ] || [ "${YCXX_HARDENED:-0}" = 1 ]; }; then
  echo "YCXX_HARDENED, YCXX_CXXFLAGS and YCXX_CONFIG_NAME apply to the own suite (ycxx) only" >&2
  exit 2
fi
ycxx_run_config || exit 2
if [ ! -d "$tests" ]; then
  ui_fail "$suite tests not found" "($tests; tools/fetch-suites downloads them)"
  exit 2
fi
ycxx_env_load
ycxx_lit_cmd
dir=$repo/build/suite-$suite
mkdir -p "$dir"
ln -sfn "$repo/tests/$suite/lit.cfg.py" "$dir/lit.cfg.py"
filter=""
while [ $# -gt 0 ] && [ "$1" != "--" ]; do filter="${filter:+$filter|}$1"; shift; done
[ "$1" = "--" ] && shift

# lit test names are "<suite> :: <path relative to the test root>"; filter on the path.
set -- ${filter:+--filter ":: ($filter)"} --param repo="$repo" --param compiler="$compiler" \
  --param tests="$tests" ${SANITIZER:+--param sanitizer=$SANITIZER} \
  ${YCXX_STDLIB:+--param stdlib=$YCXX_STDLIB} "$@"
[ "${YCXX_HARDENED:-0}" = 1 ] && set -- --param hardened=1 "$@"
if [ -n "${ycxx_config_name}" ]; then
  set -- --param "cxxflags=${YCXX_CXXFLAGS:-}" --param "config=${ycxx_config_name}" "$@"
fi
if [ "${YCXX_RAW:-0}" = 1 ]; then
  exec ${ycxx_lit} "$dir" "$@"
fi

name=$suite-$compiler${ycxx_run_suffix}
[ "${YCXX_STDLIB:-}" = libstdcxx ] && name=$name-ref
log=$repo/build/test-logs/$name.log
mkdir -p "$(dirname "$log")"
what="$suite suite, $compiler"
[ -n "${SANITIZER:-}" ] && what="$what, -fsanitize=$SANITIZER"
[ "${YCXX_HARDENED:-0}" = 1 ] && what="$what, hardened"
[ -n "${ycxx_config_name}" ] && what="$what, ${ycxx_config_name} (${YCXX_CXXFLAGS:-no extra flags})"
[ "${YCXX_STDLIB:-}" = libstdcxx ] && what="$what, against libstdc++ (reference run)"
ui_section "$what${filter:+: $filter}"
ui_info "tests" "$tests"
case $compiler in
  gcc) ui_info "compiler" "${YCXX_GXX:-g++-16}" ;;
  clang) ui_info "compiler" "${YCXX_CLANGXX:-clang++-23}" ;;
esac
ui_info "log" "$log"
# The tests link build/<compiler>: bring it up to date first, so that a run never tests a stale
# library (not for the reference runs, nor with YCXX_LIBDIR naming another build).
if [ "${YCXX_STDLIB:-}" != libstdcxx ] && [ -z "${YCXX_LIBDIR:-}" ]; then
  if [ -f "$repo/build/$compiler/build.ninja" ]; then
    ui_step "library up to date (build/$compiler)" "$repo/build/test-logs/build-$compiler-for-$name.log" \
      ninja -C "$repo/build/$compiler" || exit 1
  elif [ ! -f "$repo/build/$compiler/libycxx.a" ]; then
    ui_fail "build/$compiler is not configured" "(tools/test -c $compiler build)"
    exit 2
  fi
fi
# -a: lit prints every test's output, passing ones included: the commands the test ran, their
# exit statuses and durations, and what they printed (tests/ycxxlit/transcript.py). -o: the same
# as JSON, from which the report is made.
base=$repo/build/test-logs/$name
rm -f "$base.json" "$base.data.json" "$base.console.log"
ui_cmd ${ycxx_lit} "$dir" -a -o "$base.json" "$@"

t0=$(date +%s)
started=$(date -u +%Y-%m-%dT%H:%M:%SZ)
status=$log.status
fstatus=$log.filter-status
# lit's raw output goes to the log before the display filter, so that it is kept even if the filter
# fails; what the terminal shows (the filter's output and errors) is kept in <run>.console.log.
{
  set +e
  PYTHONUNBUFFERED=1 ${ycxx_lit} "$dir" -a -o "$base.json" "$@" 2>&1
  echo $? >"$status"
} | tee "$log" | {
  awk -v tty=${ui__tty} -v quiet="${YCXX_QUIET:-0}" \
      -v verbose="${YCXX_VERBOSE:-0}" -v details="${YCXX_FAIL_DETAILS:-10}" \
      -v red="${ui_red}" -v green="${ui_green}" -v yellow="${ui_yellow}" -v cyan="${ui_cyan}" \
      -v bold="${ui_bold}" -v dim="${ui_dim}" -v reset="${ui_reset}" \
      -v s_ok="${ui_sym_ok}" -v s_fail="${ui_sym_fail}" -v s_skip="${ui_sym_skip}" \
      -f "$repo/tools/lib/lit-progress.awk" 2>&1
  echo $? >"$fstatus"
} | tee "$base.console.log"
rc=$(cat "$status" 2>/dev/null || echo 1)
frc=$(cat "$fstatus" 2>/dev/null || echo 1)
rm -f "$status" "$fstatus"
if [ "$frc" != 0 ]; then
  # The tests may have run, but they were not shown: the harness itself is broken.
  ui_fail "the progress display (tools/lib/lit-progress.awk) failed" "(exit $frc; lit's output is in $log)"
  [ "$rc" = 0 ] && rc=1
fi
el=$(ui_duration $(($(date +%s) - t0)))
echo
if [ "$rc" = 0 ]; then ui_ok "$what: all tests passed" "($el)"
else ui_fail "$what: failures" "(lit exit $rc, $el)"; fi

# The report: every test with its result, duration and transcript, and how the run was made.
if [ -f "$base.json" ]; then
  if [ "${YCXX_STDLIB:-}" = libstdcxx ]; then cxx_used="toolchain's libstdc++"; else cxx_used="libycxx, build/$compiler"; fi
  case $compiler in gcc) cxx=${YCXX_GXX:-g++-16} ;; *) cxx=${YCXX_CLANGXX:-clang++-23} ;; esac
  commit=$(git -C "$repo" rev-parse --short=12 HEAD 2>/dev/null || echo unknown)
  dirty=$(git -C "$repo" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
  [ "$dirty" = 0 ] || commit="$commit (+$dirty uncommitted changes)"
  python3 "$repo/tools/lib/test_report.py" "$base.json" "$base" \
    "suite=$suite" "compiler=$compiler" "compiler version=$($cxx --version 2>/dev/null | head -n 1)" \
    "library=$cxx_used" "sanitizer=${SANITIZER:-none}" \
    "hardened=$([ "${YCXX_HARDENED:-0}" = 1 ] && echo yes || echo no)" \
    "configuration=${ycxx_config_name:-default}${YCXX_CXXFLAGS:+ ($YCXX_CXXFLAGS)}" "tests=$tests${filter:+ (filter: $filter)}" \
    "commit=$commit" "started=$started" "host=$(uname -srm)" \
    "command=$(ui_quote ${ycxx_lit} "$dir" -a -o "$base.json" "$@")" "log=$log" "_root=$tests" &&
    ui_info "report" "$base.html (copy buttons; the whole report as Markdown in $base.md)" &&
    ui_info "list" "$base.tsv (result, seconds, test, steps, error, counterpart)"
fi

exit "$rc"
