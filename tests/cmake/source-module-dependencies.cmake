cmake_minimum_required(VERSION 3.28)

if(NOT CXX OR NOT WORK_DIR)
  message(FATAL_ERROR "Run with -DCXX=<compiler> -DWORK_DIR=<scratch directory>")
endif()
if(CASE AND NOT CASE MATCHES "^(imports|manifests)$")
  message(FATAL_ERROR "CASE must be imports or manifests")
endif()
cmake_path(ABSOLUTE_PATH WORK_DIR)
cmake_path(SET _lib NORMALIZE "${CMAKE_CURRENT_LIST_DIR}/../..")
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef _nonce)
set(_run "${WORK_DIR}/${_nonce}")
set(_source "${_run}/source")
file(MAKE_DIRECTORY "${_source}/cmake")
file(COPY_FILE "${_lib}/cmake/ycxx-lower-module-unit.cmake" "${_source}/cmake/ycxx-lower-module-unit.cmake")
file(WRITE "${_source}/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.28)
project(source_module_dependencies LANGUAGES CXX)
set(CMAKE_CXX_SCAN_FOR_MODULES OFF)
include("${LIBYCXX_SOURCE}/cmake/ycxx-source-modules.cmake")
file(APPEND "${CMAKE_BINARY_DIR}/configures.txt" "configure\n")

add_library(flags INTERFACE)
target_compile_options(flags INTERFACE -std=c++26 -nostdinc++)
target_include_directories(flags INTERFACE "${PROJECT_SOURCE_DIR}/include" "${LIBYCXX_SOURCE}/include")
add_library(provider STATIC EXCLUDE_FROM_ALL)
target_sources(provider PUBLIC FILE_SET CXX_MODULES FILES modules/std.cppm modules/std.compat.cppm)
target_compile_features(provider PUBLIC cxx_std_23)
target_link_libraries(provider PRIVATE flags)

add_library(real STATIC src/real.cppm)
target_link_libraries(real PRIVATE flags)
ycxx_add_module_units(real STD_MODULES provider SOURCES src/real.cppm)

add_library(textual STATIC src/text_std.cppm src/text_compat.cppm)
target_link_libraries(textual PRIVATE flags)
if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
  ycxx_add_module_units(textual STD_MODULES provider SOURCES src/text_std.cppm src/text_compat.cppm)
else()
  ycxx_add_module_units(textual SOURCES src/text_std.cppm src/text_compat.cppm)
endif()
# The deferred rewrite must still copy source properties set after registration.
set_source_files_properties(src/text_std.cppm PROPERTIES COMPILE_DEFINITIONS SOURCE_VALUE=1)

add_library(control STATIC src/control.cppm)
target_link_libraries(control PRIVATE flags)
ycxx_add_module_units(control LOWERED SOURCES src/control.cppm)
add_executable(verify main.cpp "${LIBYCXX_SOURCE}/src/runtime/linkage/static.cpp")
target_link_libraries(verify PRIVATE real textual control flags)
cmake_language(DEFER CALL file GENERATE OUTPUT "${CMAKE_BINARY_DIR}/provider.txt"
               CONTENT "$<TARGET_PROPERTY:real,LINK_LIBRARIES>")
]=])
file(WRITE "${_source}/main.cpp" [=[
int real();
int text_std();
int text_compat();
int control();
int main(int argc, char**) {
  switch (argc) {
  case 1: return real();
  case 2: return text_std();
  case 3: return text_compat();
  default: return control();
  }
}
]=])

function(_write_unit name decl import body)
  string(LENGTH "${name}" _length)
  file(WRITE "${_source}/src/${name}.cppm" "module;\n#include <ycxx/core/hidden_symbol.hpp>\n"
       "${decl}export module ycxx.${name};\n${import}\n"
       "asm((::__ycxx::__detail::__hide_symbol(\"_ZGIW4ycxxW${_length}${name}\")));\n"
       "extern \"C++\" int ${name}() { return ${body}; }\n")
endfunction()

function(_manifest module header body)
  file(WRITE "${_source}/modules/${module}.cppm"
       "module;\n#include <${header}.hpp>\nexport module ${module};\n${body}\n")
endfunction()

file(WRITE "${_source}/include/std-a.hpp" "inline constexpr int header_std = 11;\n")
file(WRITE "${_source}/include/std-b.hpp" "inline constexpr int header_std = 14;\n")
file(WRITE "${_source}/include/compat-a.hpp" "inline constexpr int header_compat = 22;\n")
file(WRITE "${_source}/include/compat-b.hpp" "inline constexpr int header_compat = 25;\n")
file(WRITE "${_source}/include/anchor.hpp" "inline constexpr int anchor = 1;\n")
set(_std_export "export inline constexpr int native_std = header_std;")
set(_compat_export "export import std;\nexport inline constexpr int native_compat = header_compat;")
_manifest(std std-a "${_std_export}")
_manifest(std.compat compat-a "${_compat_export}")
_write_unit(text_std "#include <anchor.hpp>\n" "import std;" "SOURCE_VALUE + header_std")
_write_unit(text_compat "#include <anchor.hpp>\n" "import std.compat;" "anchor + header_std + header_compat")
_write_unit(control "" "" 7)
_write_unit(real "" "" 1)

function(_configure build modules)
  execute_process(COMMAND "${CMAKE_COMMAND}" -G Ninja -S "${_source}" -B "${build}"
                  "-DCMAKE_CXX_COMPILER=${CXX}" "-DLIBYCXX_SOURCE=${_lib}" "-DYCXX_SOURCE_MODULES=${modules}"
                  RESULT_VARIABLE _result OUTPUT_VARIABLE _log ERROR_VARIABLE _log)
  if(NOT _result EQUAL 0)
    message(FATAL_ERROR "Configure failed in ${build}\n${_log}")
  endif()
endfunction()

function(_build build)
  execute_process(COMMAND "${CMAKE_COMMAND}" --build "${build}" --parallel 1 --target verify
                  RESULT_VARIABLE _result OUTPUT_VARIABLE _log ERROR_VARIABLE _log)
  if(NOT _result EQUAL 0)
    message(FATAL_ERROR "Build failed in ${build}\n${_log}")
  endif()
  set(_build_log "${_log}" PARENT_SCOPE)
endfunction()

function(_verify build provider real std compat)
  file(READ "${build}/provider.txt" _link)
  if(NOT _link STREQUAL "${provider}")
    message(FATAL_ERROR "Expected link libraries '${provider}' in ${build}, found '${_link}'")
  endif()
  set(_args "")
  foreach(_value ${real} ${std} ${compat} 7)
    execute_process(COMMAND "${build}/verify" ${_args} RESULT_VARIABLE _actual)
    if(NOT _actual STREQUAL "${_value}")
      message(FATAL_ERROR "Expected exit status ${_value} in ${build} with args '${_args}', got ${_actual}")
    endif()
    list(APPEND _args probe)
  endforeach()
endfunction()

if(NOT CASE OR CASE STREQUAL "imports")
  set(_incremental "${_run}/incremental-imports")
  _configure("${_incremental}" ON)
  set(_step 0)
  foreach(_import none std std.compat none)
    if(_import STREQUAL "none")
      set(_line "")
      set(_body 1)
      set(_provider flags)
      set(_value 1)
    elseif(_import STREQUAL "std")
      set(_line "import std;")
      set(_body native_std)
      set(_provider "flags;provider")
      set(_value 11)
    else()
      set(_line "import std.compat;")
      set(_body "native_std + native_compat")
      set(_provider "flags;provider")
      set(_value 33)
    endif()
    if(_step GREATER 0)
      _write_unit(real "" "${_line}" "${_body}")
    endif()
    _build("${_incremental}")
    _verify("${_incremental}" "${_provider}" ${_value} 12 34)
    file(STRINGS "${_incremental}/configures.txt" _configures)
    list(LENGTH _configures _count)
    math(EXPR _expected "${_step} + 1")
    if(NOT _count EQUAL _expected)
      message(FATAL_ERROR "Expected ${_expected} configurations after ${_import}, got ${_count}")
    endif()
    set(_fresh "${_run}/fresh-import-${_step}")
    _configure("${_fresh}" ON)
    _build("${_fresh}")
    _verify("${_fresh}" "${_provider}" ${_value} 12 34)
    math(EXPR _step "${_step} + 1")
  endforeach()
  message(STATUS "Incremental import transitions match fresh builds and provider linkage")
endif()

if(NOT CASE OR CASE STREQUAL "manifests")
  foreach(_modules ON OFF)
    _manifest(std std-a "${_std_export}")
    _manifest(std.compat compat-a "${_compat_export}")
    set(_incremental "${_run}/incremental-manifests-${_modules}")
    _configure("${_incremental}" "${_modules}")
    _build("${_incremental}")
    _verify("${_incremental}" flags 1 12 34)
    if(NOT _modules AND _build_log MATCHES "Scanning .* for CXX dependencies")
      message(FATAL_ERROR "Plain lowering scanned a module with YCXX_SOURCE_MODULES=OFF\n${_build_log}")
    endif()
    foreach(_module std std.compat)
      if(_module STREQUAL "std")
        _manifest(std std-b "${_std_export}")
        set(_compat 37)
      else()
        _manifest(std.compat compat-b "${_compat_export}")
        set(_compat 40)
      endif()
      _build("${_incremental}")
      _verify("${_incremental}" flags 1 15 ${_compat})
      file(READ "${_incremental}/configures.txt" _configures)
      if(NOT _configures STREQUAL "configure\n" OR _build_log MATCHES "Rewriting module unit src/(control|real)\\.cppm")
        message(FATAL_ERROR "Editing ${_module} triggered configuration or rewrote an unrelated source\n${_build_log}")
      endif()
      if(_module STREQUAL "std.compat" AND _build_log MATCHES "Rewriting module unit src/text_std\\.cppm")
        message(FATAL_ERROR "Editing std.compat rewrote a unit importing only std\n${_build_log}")
      endif()
      if(NOT _modules AND _build_log MATCHES "Scanning .* for CXX dependencies")
        message(FATAL_ERROR "Plain lowering scanned a module with YCXX_SOURCE_MODULES=OFF\n${_build_log}")
      endif()
      set(_fresh "${_run}/fresh-manifest-${_modules}-${_module}")
      _configure("${_fresh}" "${_modules}")
      _build("${_fresh}")
      _verify("${_fresh}" flags 1 15 ${_compat})
    endforeach()
  endforeach()
  message(STATUS "Incremental manifest edits match fresh builds in textual and plain modes")
endif()

file(REMOVE_RECURSE "${_run}")
