+++ b/include/nlohmann/detail/input/lexer.hpp
@@ -9,6 +9,7 @@
 #pragma once
 
 #include <array> // array
+#include <cerrno> // errno, ERANGE
 #include <clocale> // localeconv
 #include <cstddef> // size_t
 #include <cstdio> // snprintf
