#!/bin/sh
# Fast local gate: policy checks, both library builds (RelWithDebInfo, what the test suites link,
# and Release, -O3, as CMake consumers build it: GCC's optimizer-dependent warnings differ between
# the two under -Werror), freestanding check. Stops at the first failure.
# The same as `tools/test --fail-fast policy build freestanding`; options pass through.
exec "$(dirname "$0")/test" --fail-fast "$@" policy build freestanding
