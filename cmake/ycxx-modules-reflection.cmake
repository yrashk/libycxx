# On GCC, an importer compiled with -freflection sees an empty std::meta when the CMI was
# built without it. CMake 4.4 and later can build a separate CMI with the importer's target options.
# Older CMake needs this check (DECISIONS §16, docs/USAGE.md "Modules"). Run it after the
# project has finished declaring targets and setting flags. The including files select
# the scope and enable the check only for GCC, CMake < 4.4 and YCXX_MODULES_REFLECTION=OFF.

function(_ycxx_reflection_targets dir out)
  get_property(targets DIRECTORY "${dir}" PROPERTY BUILDSYSTEM_TARGETS)
  get_property(subdirs DIRECTORY "${dir}" PROPERTY SUBDIRECTORIES)
  foreach(sub IN LISTS subdirs)
    _ycxx_reflection_targets("${sub}" more)
    list(APPEND targets ${more})
  endforeach()
  set(${out} "${targets}" PARENT_SCOPE)
endfunction()

function(_ycxx_reflection_resolve item out)
  set(${out} "" PARENT_SCOPE)
  if(TARGET "${item}")
    get_property(aliased TARGET "${item}" PROPERTY ALIASED_TARGET)
    if(aliased)
      set(item "${aliased}")
    endif()
    set(${out} "${item}" PARENT_SCOPE)
  endif()
endfunction()

# Read literal list items and common conditionals whose inputs are available at configure time.
function(_ycxx_reflection_active_items items config out)
  set(active "")
  set(option "")
  foreach(part IN LISTS items)
    if(option STREQUAL "")
      set(option "${part}")
    else()
      string(APPEND option ";${part}")
    endif()
    if(option MATCHES "\\$<")
      # A list in a generator expression can span several CMake list elements.
      string(REGEX MATCHALL "\\$<" openings "${option}")
      string(REGEX MATCHALL ">" closings "${option}")
      list(LENGTH openings n_open)
      list(LENGTH closings n_close)
      if(n_open GREATER n_close)
        continue()
      endif()
    endif()

    if(option MATCHES "^\\$<(1|BUILD_INTERFACE|BUILD_LOCAL_INTERFACE):(.*)>$")
      _ycxx_reflection_active_items("${CMAKE_MATCH_2}" "${config}" more)
      list(APPEND active ${more})
    elseif(option MATCHES "^\\$<TARGET_NAME_IF_EXISTS:([^$<>;]+)>$")
      if(TARGET "${CMAKE_MATCH_1}")
        list(APPEND active "${CMAKE_MATCH_1}")
      endif()
    elseif(option MATCHES "^\\$<\\$<(COMPILE_LANGUAGE|COMPILE_LANG_AND_ID|CXX_COMPILER_ID|CONFIG):([^>]+)>:(.*)>$")
      set(condition "${CMAKE_MATCH_1}")
      string(REPLACE "," ";" values "${CMAKE_MATCH_2}")
      set(body "${CMAKE_MATCH_3}")
      if(condition STREQUAL "CONFIG")
        string(TOUPPER "${values}" values)
        string(TOUPPER "${config}" value)
      elseif(condition STREQUAL "COMPILE_LANG_AND_ID")
        list(POP_FRONT values language)
        set(value "GNU")
        if(NOT language STREQUAL "CXX")
          set(values "")
        endif()
      elseif(condition STREQUAL "CXX_COMPILER_ID")
        set(value "GNU")
      else()
        set(value "CXX")
      endif()
      if(value IN_LIST values)
        _ycxx_reflection_active_items("${body}" "${config}" more)
        list(APPEND active ${more})
      endif()
    elseif(NOT option MATCHES "\\$<")
      list(APPEND active "${option}")
    endif()
    set(option "")
  endforeach()
  set(${out} "${active}" PARENT_SCOPE)
endfunction()

# CMake adds each dependency's interface options before following its interface links.
# LINK_ONLY contributes no compile options or module imports. See DECISIONS §16 for
# expressions the deferred check cannot evaluate.
function(_ycxx_reflection_dependencies links config out)
  _ycxx_reflection_active_items("${links}" "${config}" links)
  set(dependencies "")
  while(NOT links STREQUAL "")
    list(POP_FRONT links item)
    _ycxx_reflection_resolve("${item}" dep)
    if(dep STREQUAL "" OR dep IN_LIST dependencies)
      continue()
    endif()
    list(APPEND dependencies "${dep}")
    get_property(more TARGET "${dep}" PROPERTY INTERFACE_LINK_LIBRARIES)
    _ycxx_reflection_active_items("${more}" "${config}" more)
    list(PREPEND links ${more})
  endwhile()
  set(${out} "${dependencies}" PARENT_SCOPE)
endfunction()

function(_ycxx_reflection_directory_flags dir config out)
  get_directory_property(flags DIRECTORY "${dir}" DEFINITION CMAKE_CXX_FLAGS)
  if(NOT config STREQUAL "")
    string(TOUPPER "${config}" config_upper)
    get_directory_property(config_flags DIRECTORY "${dir}" DEFINITION CMAKE_CXX_FLAGS_${config_upper})
    string(APPEND flags " ${config_flags}")
  endif()
  separate_arguments(flags UNIX_COMMAND "${flags}")
  set(${out} "${flags}" PARENT_SCOPE)
endfunction()

function(_ycxx_reflection_target_options target property dependencies config out)
  get_property(options TARGET "${target}" PROPERTY "${property}")
  foreach(dep IN LISTS dependencies)
    get_property(interface_options TARGET "${dep}" PROPERTY INTERFACE_COMPILE_OPTIONS)
    list(APPEND options "${interface_options}")
  endforeach()
  _ycxx_reflection_active_items("${options}" "${config}" options)
  # Target options and usage requirements are deduplicated before SHELL: splitting.
  list(REMOVE_DUPLICATES options)
  set(flags "")
  foreach(option IN LISTS options)
    if(option MATCHES "^SHELL:(.*)$")
      separate_arguments(option UNIX_COMMAND "${CMAKE_MATCH_1}")
    endif()
    list(APPEND flags ${option})
  endforeach()
  set(${out} "${flags}" PARENT_SCOPE)
endfunction()

function(_ycxx_reflection_source_flags source target config out)
  get_property(raw SOURCE "${source}" TARGET_DIRECTORY "${target}" PROPERTY COMPILE_FLAGS)
  separate_arguments(raw UNIX_COMMAND "${raw}")
  _ycxx_reflection_active_items("${raw}" "${config}" flags)
  get_property(options SOURCE "${source}" TARGET_DIRECTORY "${target}" PROPERTY COMPILE_OPTIONS)
  _ycxx_reflection_active_items("${options}" "${config}" options)
  set(${out} "${flags};${options}" PARENT_SCOPE)
endfunction()

function(_ycxx_reflection_on flags out)
  list(FILTER flags INCLUDE REGEX "^-f(no-)?reflection$")
  set(last "")
  list(POP_BACK flags last)
  if(last STREQUAL "-freflection")
    set(${out} TRUE PARENT_SCOPE)
  else()
    set(${out} FALSE PARENT_SCOPE)
  endif()
endfunction()

# Older CMake compiles std's CMI in the module target's directory. For an installed
# package it uses the properties exported specifically for the interface units. CMake
# does not copy the in-tree module target's COMPILE_FLAGS to its synthesized CMI target.
function(_ycxx_reflection_module_on module config out)
  get_property(dir TARGET "${module}" PROPERTY SOURCE_DIR)
  _ycxx_reflection_directory_flags("${dir}" "${config}" directory_flags)
  get_property(imported TARGET "${module}" PROPERTY IMPORTED)
  if(imported)
    get_property(links TARGET "${module}" PROPERTY IMPORTED_CXX_MODULES_LINK_LIBRARIES)
    set(property IMPORTED_CXX_MODULES_COMPILE_OPTIONS)
  else()
    get_property(links TARGET "${module}" PROPERTY LINK_LIBRARIES)
    set(property COMPILE_OPTIONS)
  endif()
  _ycxx_reflection_dependencies("${links}" "${config}" deps)
  _ycxx_reflection_target_options("${module}" "${property}" "${deps}" "${config}" options)
  get_property(sources TARGET "${module}" PROPERTY CXX_MODULE_SET)
  list(FILTER sources INCLUDE REGEX "/std\\.cppm$")
  set(source_flags "")
  if(sources)
    _ycxx_reflection_source_flags("${sources}" "${module}" "${config}" source_flags)
  endif()
  _ycxx_reflection_on("${directory_flags};${options};${source_flags}" built)
  set(${out} "${built}" PARENT_SCOPE)
endfunction()

function(_ycxx_reflection_check_target target dir config modules resolved_modules)
  get_property(links TARGET "${target}" PROPERTY LINK_LIBRARIES)
  _ycxx_reflection_dependencies("${links}" "${config}" deps)
  set(std_module "")
  foreach(module module_name IN ZIP_LISTS resolved_modules modules)
    if(module IN_LIST deps)
      set(std_module "${module}")
      set(std_target "${module_name}")
      break()
    endif()
  endforeach()
  if(std_module STREQUAL "")
    return()
  endif()

  get_property(sources TARGET "${target}" PROPERTY SOURCES)
  get_property(module_sets TARGET "${target}" PROPERTY CXX_MODULE_SETS)
  foreach(module_set IN LISTS module_sets)
    if(module_set STREQUAL "CXX_MODULES")
      get_property(more TARGET "${target}" PROPERTY CXX_MODULE_SET)
    else()
      get_property(more TARGET "${target}" PROPERTY CXX_MODULE_SET_${module_set})
    endif()
    list(APPEND sources "${more}")
  endforeach()
  foreach(dep IN LISTS deps)
    get_property(more TARGET "${dep}" PROPERTY INTERFACE_SOURCES)
    list(APPEND sources "${more}")
  endforeach()
  _ycxx_reflection_active_items("${sources}" "${config}" sources)

  _ycxx_reflection_directory_flags("${dir}" "${config}" directory_flags)
  get_property(target_flags TARGET "${target}" PROPERTY COMPILE_FLAGS)
  separate_arguments(target_flags UNIX_COMMAND "${target_flags}")
  _ycxx_reflection_target_options("${target}" COMPILE_OPTIONS "${deps}" "${config}" options)
  get_property(binary_dir TARGET "${target}" PROPERTY BINARY_DIR)

  foreach(source IN LISTS sources)
    # Use the target's directories when resolving paths for its source properties.
    # A relative output of add_custom_command is in the target's binary directory.
    cmake_path(ABSOLUTE_PATH source BASE_DIRECTORY "${dir}" NORMALIZE OUTPUT_VARIABLE source_path)
    if(NOT IS_ABSOLUTE "${source}" AND NOT EXISTS "${source_path}")
      cmake_path(ABSOLUTE_PATH source BASE_DIRECTORY "${binary_dir}" NORMALIZE OUTPUT_VARIABLE source_path)
    endif()
    set(source "${source_path}")
    get_property(language SOURCE "${source}" TARGET_DIRECTORY "${target}" PROPERTY LANGUAGE)
    get_property(header SOURCE "${source}" TARGET_DIRECTORY "${target}" PROPERTY HEADER_FILE_ONLY)
    get_property(external SOURCE "${source}" TARGET_DIRECTORY "${target}" PROPERTY EXTERNAL_OBJECT)
    if(NOT language STREQUAL "CXX" OR header OR external)
      continue()
    endif()
    _ycxx_reflection_source_flags("${source}" "${target}" "${config}" source_flags)
    _ycxx_reflection_on("${directory_flags};${target_flags};${options};${source_flags}" wanted)
    if(NOT wanted)
      continue()
    endif()
    _ycxx_reflection_module_on("${std_module}" "${config}" built)
    if(NOT built)
      message(FATAL_ERROR
              "libycxx: target ${target} compiles with -freflection, but the std module it imports "
              "(${std_target}) is built without it, so std::meta would be empty. "
              "Affected C++ source ${source} (configuration '${config}'). Configure libycxx "
              "with -DYCXX_MODULES_REFLECTION=ON (which also gives -freflection to every target that "
              "links the modules), drop -freflection from ${target}, or use CMake 4.4 or later with "
              "-freflection in target_compile_options (DECISIONS §16, docs/USAGE.md, \"Modules\").")
    endif()
    return()
  endforeach()
endfunction()

function(_ycxx_check_modules_reflection scope)
  set(modules ycxx::modules ycxx::shared_modules)
  set(resolved_modules "")
  foreach(module_name IN LISTS modules)
    _ycxx_reflection_resolve("${module_name}" module)
    if(module STREQUAL "")
      set(module "${module_name}")
    endif()
    list(APPEND resolved_modules "${module}")
  endforeach()
  _ycxx_reflection_targets("${scope}" targets)
  get_property(multi_config GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)
  foreach(target IN LISTS targets)
    get_property(type TARGET "${target}" PROPERTY TYPE)
    if(type STREQUAL "INTERFACE_LIBRARY" OR type STREQUAL "UTILITY" OR target IN_LIST resolved_modules)
      continue()
    endif()
    get_property(dir TARGET "${target}" PROPERTY SOURCE_DIR)
    if(multi_config)
      get_directory_property(configs DIRECTORY "${dir}" DEFINITION CMAKE_CONFIGURATION_TYPES)
      foreach(config IN LISTS configs)
        _ycxx_reflection_check_target("${target}" "${dir}" "${config}" "${modules}" "${resolved_modules}")
      endforeach()
    else()
      get_directory_property(config DIRECTORY "${dir}" DEFINITION CMAKE_BUILD_TYPE)
      _ycxx_reflection_check_target("${target}" "${dir}" "${config}" "${modules}" "${resolved_modules}")
    endif()
  endforeach()
endfunction()

get_property(_ycxx_reflection_check_deferred DIRECTORY "${_ycxx_reflection_scope}"
             PROPERTY _YCXX_MODULES_REFLECTION_CHECK)
if(NOT _ycxx_reflection_check_deferred)
  set_property(DIRECTORY "${_ycxx_reflection_scope}" PROPERTY _YCXX_MODULES_REFLECTION_CHECK TRUE)
  cmake_language(EVAL CODE "cmake_language(DEFER DIRECTORY [[${_ycxx_reflection_scope}]] CALL
                 _ycxx_check_modules_reflection [[${_ycxx_reflection_scope}]])")
endif()
unset(_ycxx_reflection_check_deferred)
