# libycxx package configuration: find_package(libycxx CONFIG) provides
#   ycxx::ycxx     link this into every C++ target (headers, libycxx, its ABI runtime): the
#                  installation's default kind, ycxx::static when the static archives are built
#   ycxx::static   the static archives (libycxx_BUILT_STATIC)
#   ycxx::shared   the shared library and libycxx_nonshared.a, compiling in shared mode
#                  (YCXX_SHARED; libycxx_BUILT_SHARED). DECISIONS §20.2. One image links one kind:
#                  CMake stops a target whose dependencies link both (the YCXX_LINKAGE property)
#   ycxx::headers  the headers only (-nostdinc++ and C++26 included)
#   ycxx::core     libycxx.a; ycxx::abi: libycxx-abi.a, the Itanium C++ ABI runtime (static)
#   ycxx::shared_library, ycxx::nonshared   libycxx.so.0.<minor> and libycxx_nonshared.a (shared)
#   ycxx::modules  the std and std.compat modules for ycxx::ycxx; ycxx::shared_modules for
#                  ycxx::shared when both kinds are built
@PACKAGE_INIT@

set(libycxx_BUILT_WITH_COMPILER_ID "@CMAKE_CXX_COMPILER_ID@")
set(libycxx_BUILT_WITH_COMPILER_VERSION "@CMAKE_CXX_COMPILER_VERSION@")

# The consumer's C++ compiler must itself support libycxx's headers.
if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU" AND CMAKE_CXX_COMPILER_VERSION VERSION_LESS 16.2)
  set(_ycxx_bad TRUE)
elseif(CMAKE_CXX_COMPILER_ID STREQUAL "Clang" AND CMAKE_CXX_COMPILER_VERSION VERSION_LESS 23)
  set(_ycxx_bad TRUE)
elseif(CMAKE_CXX_COMPILER_ID AND NOT CMAKE_CXX_COMPILER_ID MATCHES "^(GNU|Clang)$")
  set(_ycxx_bad TRUE)
endif()
if(_ycxx_bad)
  set(libycxx_FOUND FALSE)
  set(libycxx_NOT_FOUND_MESSAGE
      "libycxx needs GCC >= 16.2 or Clang >= 23; this project uses ${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}")
  unset(_ycxx_bad)
  return()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/libycxxTargets.cmake")
set(libycxx_BUILT_STATIC @YCXX_BUILT_STATIC@)
set(libycxx_BUILT_SHARED @YCXX_BUILT_SHARED@)

# The hosted layers this build has (DECISIONS §18) and ycxx_add_hosted_layer, which attaches the
# program's providers of a YCXX_PAL=none build to ycxx::ycxx.
set(libycxx_PAL "@YCXX_PAL@")
set(libycxx_HOSTED_LAYERS "@YCXX_SELECTED_HOSTED_LAYERS@")
include("${CMAKE_CURRENT_LIST_DIR}/ycxx-hosted-layers.cmake")
set_property(GLOBAL PROPERTY YCXX_PAL_SELECTED "${libycxx_PAL}")
set_property(GLOBAL PROPERTY YCXX_HOSTED_LAYERS_SELECTED "${libycxx_HOSTED_LAYERS}")
set_property(GLOBAL PROPERTY YCXX_PAL_INCLUDE_DIR "${PACKAGE_PREFIX_DIR}/@YCXX_INSTALL_INCLUDEDIR@")

# Linux, Clang: the C runtime startup files and libgcc come from GCC 16's installation, not
# Clang's default choice of GCC (which can be older), as with tools/ycxx-cxx and the toolchain
# file. The directory: the consumer's YCXX_GCC_INSTALL_DIR (CMake or environment variable), else
# the one recorded when libycxx was built; nothing when CMAKE_CXX_FLAGS already has one.
set(_ycxx_gcc_dir "@YCXX_GCC_INSTALL_DIR@")
if(DEFINED YCXX_GCC_INSTALL_DIR)
  set(_ycxx_gcc_dir "${YCXX_GCC_INSTALL_DIR}")
elseif(DEFINED ENV{YCXX_GCC_INSTALL_DIR})
  set(_ycxx_gcc_dir "$ENV{YCXX_GCC_INSTALL_DIR}")
endif()
foreach(_ycxx_t ycxx::static ycxx::shared)
  if(NOT TARGET ${_ycxx_t})
    continue()
  endif()
  get_target_property(_ycxx_opts ${_ycxx_t} INTERFACE_LINK_OPTIONS) # once, if found again
  if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_CXX_COMPILER_ID STREQUAL "Clang" AND
     _ycxx_gcc_dir AND IS_DIRECTORY "${_ycxx_gcc_dir}" AND NOT CMAKE_CXX_FLAGS MATCHES "--gcc-install-dir=" AND
     NOT "${_ycxx_opts}" MATCHES "--gcc-install-dir=")
    set_property(TARGET ${_ycxx_t} APPEND PROPERTY INTERFACE_COMPILE_OPTIONS
                 "$<$<COMPILE_LANG_AND_ID:CXX,Clang>:--gcc-install-dir=${_ycxx_gcc_dir}>")
    set_property(TARGET ${_ycxx_t} APPEND PROPERTY INTERFACE_LINK_OPTIONS
                 "$<$<AND:$<LINK_LANGUAGE:CXX>,$<CXX_COMPILER_ID:Clang>>:--gcc-install-dir=${_ycxx_gcc_dir}>")
  endif()
endforeach()
unset(_ycxx_t)
unset(_ycxx_gcc_dir)
unset(_ycxx_opts)

# ycxx::modules: the importing project compiles the interface units of std and std.compat with
# the options exported for them, which lack the headers' directory (CMakeLists.txt, YCXX_MODULES).
foreach(_ycxx_t ycxx::modules ycxx::shared_modules)
  if(TARGET ${_ycxx_t})
    get_target_property(_ycxx_opts ${_ycxx_t} IMPORTED_CXX_MODULES_COMPILE_OPTIONS)
    if(NOT "${_ycxx_opts}" MATCHES "-isystem")
      set_property(TARGET ${_ycxx_t} APPEND PROPERTY IMPORTED_CXX_MODULES_COMPILE_OPTIONS
                   "SHELL:-isystem ${PACKAGE_PREFIX_DIR}/@YCXX_INSTALL_INCLUDEDIR@")
    endif()
    unset(_ycxx_opts)
  endif()
endforeach()
unset(_ycxx_t)
check_required_components(libycxx)
