{{!--
    libycxx API reference: the page of one symbol.

    A header row (the name, its kind, and a facts sheet: header, draft section, namespace and
    the cppreference link, which tools/gen-apidocs adds at <!--ycxx:facts-->), the synopsis
    (an overload set grouped and numbered (1), (2)… as the standard and cppreference show
    them), then the members, grouped as the draft's class synopses group them.

    Expected Context: {Root Context Object}. MrDocs 2026.9.29's DOM: symbols refer to each
    other by id (@root.mrdocs.corpus.get, getUrl).
--}}
<article class="ref" data-kind="{{symbol.kind}}" data-q="{{> symbol/qualified-name-text symbol }}" data-file="{{#with (primary_location symbol)}}{{shortPath}}{{/with}}" data-label="{{> ycxx/kind symbol }}">
{{> ycxx/crumbs symbol }}
<header class="ref-head">
<p class="label">{{> ycxx/kind symbol }}</p>
<h1 class="ref-name">{{#if (and symbol.parent (lookup (@root.mrdocs.corpus.get symbol.parent) "parent"))}}<span class="ref-scope">{{> symbol/qualified-name-text (@root.mrdocs.corpus.get symbol.parent) }}::</span>{{/if}}<span class="ref-leaf">{{#if (eq symbol.kind "namespace")}}{{#if symbol.name}}{{symbol.name}}{{else}}Global namespace{{/if}}{{else}}{{> symbol/name-text symbol }}{{/if}}</span></h1>
<!--ycxx:facts-->
</header>
{{#if symbol.doc.brief}}
<div class="ref-brief">{{> doc/block/brief symbol.doc.brief }}</div>
{{/if}}
{{#unless (eq symbol.kind "namespace")}}
{{> ycxx/synopsis symbol }}
{{/unless}}
{{#if (eq symbol.kind "record")}}
{{#with symbol.interface}}
{{> ycxx/members tranche=public label="" scope="record"}}
{{> ycxx/members tranche=protected label="Protected " scope="record"}}
{{/with}}
{{else if (eq symbol.kind "namespace")}}
{{> ycxx/members tranche=symbol.members label="" scope="namespace"}}
{{else if (eq symbol.kind "enum")}}
{{#if symbol.constants}}
<section class="ref-sec" aria-labelledby="sec-enumerators">
<h2 id="sec-enumerators">Enumerators</h2>
<div class="table-wrap"><table class="data members">
<thead><tr><th scope="col">Name</th><th scope="col">Value</th></tr></thead>
<tbody>
{{#each (transform symbol.constants @root.mrdocs.corpus.get)}}
<tr><td><code class="m-name">{{name}}</code></td><td>{{#if initializer.written}}<code class="cpp">{{initializer.written}}</code>{{/if}}</td></tr>
{{/each}}
</tbody></table></div>
</section>
{{/if}}
{{/if}}
{{#if symbol.derived}}
<section class="ref-sec" aria-labelledby="sec-derived">
<h2 id="sec-derived">Derived classes</h2>
<ul class="chips">
{{#each (transform symbol.derived @root.mrdocs.corpus.get)}}<li>{{#if (@root.mrdocs.corpus.getUrl this)}}<a href="{{{relativize (@root.mrdocs.corpus.getUrl this)}}}"><code>{{> symbol/qualified-name-text . }}</code></a>{{else}}<code>{{> symbol/qualified-name-text . }}</code>{{/if}}</li>
{{/each}}
</ul>
</section>
{{/if}}
{{#if symbol.doc.description}}
<section class="ref-sec ref-doc">
<h2>Description</h2>
{{> doc/block/document symbol.doc.description }}
</section>
{{/if}}
</article>
