#!/bin/sh
# Provision the compilers libycxx is built and tested with: GCC 16.2 and Clang 23.1 (with lld).
# Linux and macOS.
#
#   tools/toolchain/provision [--prefix DIR] [--gcc-only | --clang-only] [--detect-only]
#                             [--use-brew] [--jobs N] [--force]
#
# For each compiler it uses, in order:
#   1. an earlier installation under the prefix (default ~/.local/share/ycxx/toolchains,
#      or $YCXX_TOOLCHAINS);
#   2. a matching compiler already installed: g++-16 / clang++-23 or unsuffixed g++ / clang++
#      reporting the right version on PATH, and on macOS Homebrew's llvm keg;
#   3. otherwise it installs one: Clang from the LLVM release tarball, GCC built from the
#      release source (C and C++ only; takes a while), both under the prefix, no root needed.
#      With --use-brew (macOS or Linux with Homebrew) it runs `brew install gcc llvm lld`
#      instead, so Homebrew owns the compilers.
# --detect-only never downloads or builds; --force reinstalls under the prefix.
# The versions can be overridden with YCXX_GCC_VERSION / YCXX_LLVM_VERSION.
#
# It writes <prefix>/toolchains.env (KEY=value lines, absolute paths), which
# tools/toolchain/activate.sh (bash, zsh), activate.fish and cmake/ycxx-toolchain.cmake read.
set -eu

GCC_VERSION=${YCXX_GCC_VERSION:-16.2.0}
LLVM_VERSION=${YCXX_LLVM_VERSION:-23.1.2}
GCC_MAJOR=${GCC_VERSION%%.*}
GCC_MINOR=$(echo "$GCC_VERSION" | cut -d. -f2)
LLVM_MAJOR=${LLVM_VERSION%%.*}

os=$(uname -s)
arch=$(uname -m)
prefix=${YCXX_TOOLCHAINS:-${XDG_DATA_HOME:-$HOME/.local/share}/ycxx/toolchains}
want_gcc=1
want_clang=1
detect_only=0
force=0
use_brew=0
jobs=$(getconf _NPROCESSORS_ONLN 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4)

while [ $# -gt 0 ]; do
  case $1 in
    --prefix) prefix=$2; shift ;;
    --prefix=*) prefix=${1#--prefix=} ;;
    --gcc-only) want_clang=0 ;;
    --clang-only) want_gcc=0 ;;
    --detect-only) detect_only=1 ;;
    --force) force=1 ;;
    --use-brew) use_brew=1 ;;
    --jobs) jobs=$2; shift ;;
    --jobs=*) jobs=${1#--jobs=} ;;
    -h|--help) sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "provision: unknown option $1" >&2; exit 2 ;;
  esac
  shift
done

mkdir -p "$prefix"
prefix=$(cd "$prefix" && pwd)
conf=$prefix/toolchains.env

say() { printf 'provision: %s\n' "$*" >&2; }
die() { say "error: $*"; exit 1; }

fetch() { # url dest
  if command -v curl >/dev/null 2>&1; then curl -fL --retry 3 -o "$2" "$1"
  elif command -v wget >/dev/null 2>&1; then wget -O "$2" "$1"
  else die "need curl or wget to download $1"; fi
}

# version_of <compiler> -> major.minor.patch, or empty
version_of() { "$1" -dumpfullversion 2>/dev/null || "$1" -dumpversion 2>/dev/null || true; }

# gcc_ok <version>: at least GCC_MAJOR.GCC_MINOR within the same major version.
gcc_ok() {
  maj=${1%%.*}
  min=$(echo "$1" | cut -d. -f2)
  [ "$maj" = "$GCC_MAJOR" ] && [ "${min:-0}" -ge "$GCC_MINOR" ] 2>/dev/null
}

sdk=
if [ "$os" = Darwin ]; then
  sdk=$(xcrun --show-sdk-path 2>/dev/null) ||
    die "the macOS SDK is missing; install the Command Line Tools: xcode-select --install"
fi

brew_prefix() { command -v brew >/dev/null 2>&1 && brew --prefix "$1" 2>/dev/null; }

# ---------------------------------------------------------------------------------------------
# GCC
# ---------------------------------------------------------------------------------------------
gcc_bin=
gxx_name=g++
find_gcc() {
  gcc_bin=
  if [ $force = 0 ] && [ -x "$prefix/gcc-$GCC_VERSION/bin/g++" ]; then
    gcc_bin=$prefix/gcc-$GCC_VERSION/bin; gxx_name=g++; return 0
  fi
  [ $force = 1 ] && return 1
  for cxx in "g++-$GCC_MAJOR" g++; do
    p=$(command -v "$cxx" 2>/dev/null) || continue
    # Apple's g++ is Clang in disguise; its version does not match anyway.
    if gcc_ok "$(version_of "$p")"; then gcc_bin=$(dirname "$p"); gxx_name=$cxx; return 0; fi
  done
  bp=$(brew_prefix gcc) || bp=
  if [ -n "$bp" ] && [ -x "$bp/bin/g++-$GCC_MAJOR" ] && gcc_ok "$(version_of "$bp/bin/g++-$GCC_MAJOR")"; then
    gcc_bin=$bp/bin; gxx_name=g++-$GCC_MAJOR; return 0
  fi
  return 1
}

install_gcc() {
  if [ $use_brew = 1 ]; then
    say "brew install gcc"
    brew install gcc || die "brew install gcc failed"
    find_gcc || die "Homebrew's gcc is not GCC $GCC_MAJOR.$GCC_MINOR or later"
    return
  fi
  src=$prefix/src/gcc-$GCC_VERSION
  dest=$prefix/gcc-$GCC_VERSION
  mkdir -p "$prefix/src"
  if [ ! -d "$src" ]; then
    say "downloading GCC $GCC_VERSION source"
    fetch "https://ftp.gnu.org/gnu/gcc/gcc-$GCC_VERSION/gcc-$GCC_VERSION.tar.xz" "$prefix/src/gcc.tar.xz"
    tar -xJf "$prefix/src/gcc.tar.xz" -C "$prefix/src"
    rm -f "$prefix/src/gcc.tar.xz"
  fi
  say "fetching GCC prerequisites (GMP, MPFR, MPC, ISL)"
  (cd "$src" && ./contrib/download_prerequisites >/dev/null)
  build=$prefix/src/gcc-build
  rm -rf "$build"
  mkdir -p "$build"
  extra=
  # macOS: the C library and headers live in the SDK.
  [ -n "$sdk" ] && extra="--with-sysroot=$sdk --with-native-system-header-dir=/usr/include"
  say "configuring and building GCC $GCC_VERSION with $jobs jobs (this takes a while)"
  # shellcheck disable=SC2086
  (cd "$build" &&
   "$src/configure" --prefix="$dest" --enable-languages=c,c++ --disable-multilib \
     --disable-bootstrap --disable-nls $extra >"$build/configure.log" 2>&1 &&
   make -j"$jobs" >"$build/make.log" 2>&1 &&
   make install >"$build/install.log" 2>&1) || {
    [ "$os" = Darwin ] && say "on macOS, 'provision --use-brew' installs Homebrew's GCC instead"
    die "GCC build failed; see the logs in $build"
  }
  rm -rf "$build"
  gcc_bin=$dest/bin
  gxx_name=g++
}

# ---------------------------------------------------------------------------------------------
# Clang / LLVM
# ---------------------------------------------------------------------------------------------
clang_bin=
clang_suffix=
lld_path=
# lld: needed on Linux (host links and the freestanding check); optional on macOS, whose own
# linker serves host links.
find_lld() {
  lld_path=
  for l in "$1/ld.lld$2" "$(command -v "ld.lld$2" 2>/dev/null || true)"; do
    [ -n "$l" ] && [ -x "$l" ] && { lld_path=$l; return 0; }
  done
  bp=$(brew_prefix lld) || bp=
  [ -n "$bp" ] && [ -x "$bp/bin/ld.lld" ] && { lld_path=$bp/bin/ld.lld; return 0; }
  [ "$os" = Darwin ]
}
clang_candidate() { # dir suffix
  p=$1/clang++$2
  [ -x "$p" ] || return 1
  case $(version_of "$p") in
    "$LLVM_MAJOR".*) find_lld "$1" "$2" || return 1
                     clang_bin=$1; clang_suffix=$2; return 0 ;;
  esac
  return 1
}
find_clang() {
  clang_bin=
  if [ $force = 0 ] && clang_candidate "$prefix/llvm-$LLVM_VERSION/bin" ""; then return 0; fi
  [ $force = 1 ] && return 1
  for suffix in "-$LLVM_MAJOR" ""; do
    p=$(command -v "clang++$suffix" 2>/dev/null) || continue
    clang_candidate "$(dirname "$p")" "$suffix" && return 0
  done
  # Homebrew's llvm is keg-only (not on PATH).
  for keg in "llvm@$LLVM_MAJOR" llvm; do
    bp=$(brew_prefix "$keg") || continue
    [ -n "$bp" ] && clang_candidate "$bp/bin" "" && return 0
  done
  return 1
}

install_clang() {
  if [ $use_brew = 1 ]; then
    say "brew install llvm lld"
    brew install llvm lld || die "brew install llvm lld failed"
    find_clang || die "Homebrew's llvm is not Clang $LLVM_MAJOR"
    return
  fi
  case $os-$arch in
    Linux-x86_64) assets="LLVM-$LLVM_VERSION-Linux-X64" ;;
    Linux-aarch64|Linux-arm64) assets="LLVM-$LLVM_VERSION-Linux-ARM64" ;;
    Darwin-arm64) assets="LLVM-$LLVM_VERSION-macOS-ARM64" ;;
    Darwin-x86_64) assets="LLVM-$LLVM_VERSION-macOS-X64" ;;
    *) die "no LLVM release binary for $os-$arch; install Clang $LLVM_MAJOR and lld yourself (or --use-brew)" ;;
  esac
  for asset in $assets; do
    say "downloading $asset"
    if fetch "https://github.com/llvm/llvm-project/releases/download/llvmorg-$LLVM_VERSION/$asset.tar.xz" \
         "$prefix/$asset.tar.xz"; then
      rm -rf "$prefix/llvm-$LLVM_VERSION" "$prefix/$asset"
      tar -xJf "$prefix/$asset.tar.xz" -C "$prefix"
      mv "$prefix/$asset" "$prefix/llvm-$LLVM_VERSION"
      rm -f "$prefix/$asset.tar.xz"
      clang_candidate "$prefix/llvm-$LLVM_VERSION/bin" "" ||
        die "the downloaded LLVM in $prefix/llvm-$LLVM_VERSION is unusable"
      return
    fi
    rm -f "$prefix/$asset.tar.xz"
  done
  die "could not download LLVM $LLVM_VERSION for $os-$arch (try --use-brew)"
}

# ---------------------------------------------------------------------------------------------
if [ $want_gcc = 1 ]; then
  if find_gcc; then say "GCC: $gcc_bin/$gxx_name ($(version_of "$gcc_bin/$gxx_name"))"
  elif [ $detect_only = 1 ]; then say "GCC $GCC_MAJOR.$GCC_MINOR: not found"
  else install_gcc; say "GCC: $gcc_bin/$gxx_name"; fi
fi
if [ $want_clang = 1 ]; then
  if find_clang; then say "Clang: $clang_bin/clang++$clang_suffix ($(version_of "$clang_bin/clang++$clang_suffix"))"
  elif [ $detect_only = 1 ]; then say "Clang $LLVM_MAJOR: not found"
  else install_clang; say "Clang: $clang_bin/clang++$clang_suffix"; fi
fi

# Keep entries of a toolchain this run did not look at.
old_gcc= old_clang=
if [ -f "$conf" ]; then
  old_gcc=$(grep '^YCXX_G' "$conf" || true)
  old_clang=$(grep -e '^YCXX_CLANG' -e '^YCXX_LLD' -e '^YCXX_LLVM' "$conf" || true)
fi

tmp=$conf.tmp
{
  echo "# Written by tools/toolchain/provision or cmake/ycxx-toolchain.cmake; read by both and"
  echo "# by tools/toolchain/activate.{sh,fish}."
  [ -n "$sdk" ] && echo "YCXX_SDKROOT=$sdk"
  if [ -n "$gcc_bin" ]; then
    gcc_name=$(echo "$gxx_name" | sed 's/g++/gcc/')
    echo "YCXX_GCC_BIN=$gcc_bin"
    echo "YCXX_GCC=$gcc_bin/$gcc_name"
    echo "YCXX_GXX=$gcc_bin/$gxx_name"
    echo "YCXX_GCC_INSTALL_DIR=$(dirname "$("$gcc_bin/$gxx_name" -print-libgcc-file-name)")"
  elif [ $want_gcc = 0 ] && [ -n "$old_gcc" ]; then
    echo "$old_gcc"
  fi
  if [ -n "$clang_bin" ]; then
    echo "YCXX_CLANG_BIN=$clang_bin"
    echo "YCXX_CLANG=$clang_bin/clang$clang_suffix"
    echo "YCXX_CLANGXX=$clang_bin/clang++$clang_suffix"
    [ -n "$lld_path" ] && echo "YCXX_LLD=$lld_path"
    ar=$clang_bin/llvm-ar$clang_suffix
    [ -x "$ar" ] && echo "YCXX_LLVM_AR=$ar"
  elif [ $want_clang = 0 ] && [ -n "$old_clang" ]; then
    echo "$old_clang"
  fi
} > "$tmp"
mv "$tmp" "$conf"
say "wrote $conf"

[ $want_gcc = 0 ] || [ -n "$gcc_bin" ] || exit 1
[ $want_clang = 0 ] || [ -n "$clang_bin" ] || exit 1
exit 0
