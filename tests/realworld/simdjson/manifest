# simdjson: SIMD JSON parser: string_view, <charconv>-like number parsing, exceptions, error codes,
# containers. Its developer mode builds the tests.
url = https://github.com/simdjson/simdjson.git
ref = v5.0.2
commit = c9030726ebbf5f9fe9f9facb4a401f6d3ccd77a2
exercises = string_view, containers, exceptions, iostreams
# Its developer mode downloads the test data and a few libraries as GitHub archives (CPM): no
# downloads (the competition benchmarks and the tools' cxxopts go), and the two it always needs
# from git clones of the same commits.
extra_sources = counters https://github.com/lemire/counters.git d5a84ca84a24edb14e0fd7c98c57131b535aee58; simdjson-data https://github.com/simdjson/simdjson-data.git 351949906abde446f0314bf79606fb5d884f5be7
configure = -DSIMDJSON_DEVELOPER_MODE=ON -DSIMDJSON_ENABLE_THREADS=ON -DSIMDJSON_ALLOW_DOWNLOADS=OFF -DCPM_counters_SOURCE=@SRC:counters@ -DCPM_simdjson-data_SOURCE=@SRC:simdjson-data@
