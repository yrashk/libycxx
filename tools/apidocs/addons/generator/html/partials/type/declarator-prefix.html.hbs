{{!--
    libycxx: the part of a declarator before the name, written the way the standard writes it:
    `const T&` (cv-qualifiers before a named type, not after) and `Args&&...` (the pack
    expansion once, after the declarator, not also after the pattern's type).
    Parameters: as MrDocs's type/declarator-prefix; in-pattern: inside a pack's pattern.
--}}
{{#if pointee-type~}}
    {{~>type/declarator-prefix pointee-type link-components-impl=link-components-impl in-pattern=(or in-pattern is-pack)~}}
    {{#if (contains (arr "array" "function") pointee-type.kind)~}}
        (
    {{~/if~}}
{{~/if~}}
{{#if element-type~}}
    {{~>type/declarator-prefix element-type link-components-impl=link-components-impl in-pattern=(or in-pattern is-pack)~}}
{{/if~}}
{{#if return-type~}}
    {{~>type/declarator-prefix return-type link-components-impl=link-components-impl~}}
{{/if~}}
{{#if (eq kind "named")~}}
    {{#if is-const}}const {{/if}}{{#if is-volatile}}volatile {{/if~}}
    {{>type/name-info name link-components-impl=link-components-impl }}
{{~else if (eq kind "auto")~}}
    {{#if is-const}}const {{/if}}{{#if is-volatile}}volatile {{/if~}}
    {{#if constraint~}}
        {{>type/name-info constraint link-components-impl=link-components-impl }} {{/if~}}
    {{keyword~}}
{{~else~}}
{{#if is-const~}}
    {{ str ' ' }}const
{{~/if~}}
{{#if is-volatile~}}
    {{ str ' ' }}volatile
{{~/if~}}
{{~/if~}}
{{#if (eq kind "lvalue-reference")~}}
    &
{{~ else if (eq kind "rvalue-reference") ~}}
    &&
{{~ else if (eq kind "pointer")~}}
    *
{{~ else if (eq kind "member-pointer")~}}
    {{>type/declarator parent-type link-components-impl=link-components-impl}}::*
{{~ else if (eq kind "decltype")~}}
    decltype({{operand}})
{{~/if~}}
{{#if (and is-pack (not in-pattern))~}}
    {{ str "..." }}
{{~/if}}
