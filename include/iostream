// -*- C++ -*-  libycxx: <iostream>   [hosted]
//
// The eight standard objects are defined in the hosted runtime (src/hosted/iostream.cpp). On ELF
// targets they are constructed by an ios_base::Init object of the runtime that is initialized
// before any object with ordinary static initialization (GCC/Clang init_priority), so they are
// usable from every static initializer and destructor of the program ([iostream.objects.overview]
// /2-3). Mach-O has no initialization priorities across object files, so there each translation
// unit that includes this header defines an ios_base::Init object ([iostream.objects.overview]/5),
// initialized before the static objects defined after the #include. They are never destroyed;
// the last Init object to be destroyed flushes the output objects at exit (DECISIONS §7).
#pragma once

#include <ycxx/config.hpp>
// Its runtime (or the header itself) needs the C library: a translation unit compiled freestanding
// (a hosted-layers build without the C library, DECISIONS §18) stops here, not in the C library's
// missing headers or at link time.
#if !YCXX_HOSTED
#  error "libycxx: <iostream> needs the C library (the 'clib' hosted layer, DECISIONS §18); this translation unit is compiled freestanding"
#endif
#include <ycxx/core/version.hpp>
#include <ios>
#include <streambuf>
#include <istream>
#include <ostream>

namespace [[__gnu__::__visibility__("hidden")]] std {
extern istream cin;
extern ostream cout;
extern ostream cerr;
extern ostream clog;
extern wistream wcin;
extern wostream wcout;
extern wostream wcerr;
extern wostream wclog;
} // namespace std

namespace [[__gnu__::__visibility__("hidden")]] __ycxx { namespace __detail {
// [iostream.objects.overview]/5: this translation unit's ios_base::Init object, where the
// runtime's own cannot be ordered first (cfg::init_priority false: Mach-O); an empty object
// otherwise. Internal linkage: one per translation unit.
struct __no_ios_init {};
using __tu_ios_init = std::conditional_t<__cfg::__init_priority, __no_ios_init, std::ios_base::Init>;
[[maybe_unused]] static __tu_ios_init __ios_init_object;
}} // namespace __ycxx::__detail
