#!/bin/sh
# libycxx's test driver: runs the checks and test suites in stages, showing each command, live
# progress and a summary. Linux and macOS.
#
#   tools/test [options] [stage...]
#
# Stages (default: policy build freestanding ycxx; "all": every stage):
#   policy        preprocessor, include-layering, namespace-visibility and shell-portability
#                 checks (tools/check_*.py), the headers' reserved names (tools/uglify.py --check)
#                 and the std modules' export lists (tools/gen_std_module.py --check)
#   build         the library for each compiler, RelWithDebInfo (build/<cc>, what the suites
#                 link) and Release (build/<cc>-release, -O3, as CMake consumers build it)
#   freestanding  every core header with -ffreestanding -nostdinc, bare-metal smoke link
#   cmake         CMake package, add_subdirectory and toolchain file (tests/cmake/run.sh)
#   ycxx          libycxx's own spec-derived suite (tests/ycxx)
#                 (each suite lists every test with the steps it ran and their exit statuses,
#                 and writes build/test-logs/<suite>-<cc>.html, a report of every test with the
#                 commands it ran and their output, and .tsv, one line per test)
#   libcxx        libc++'s test suite, run only ($LIBCXX_TESTS; tools/fetch-suites gets it)
#   libstdcxx     libstdc++'s test suite, run only ($LIBSTDCXX_TESTS; tools/fetch-suites gets it)
#
# Options:
#   -c, --compiler gcc|clang   only this compiler (repeatable; default both)
#   -f, --filter DIR           suite stages: only tests under DIR (repeatable)
#   -j, --jobs N               parallel jobs for ninja and lit
#   -s, --sanitizer LIST       suite stages: build tests with -fsanitize (asan, ubsan, tsan) and
#                              link them with libycxx built with the same sanitizers
#                              (build/<cc>-<sanitizers>, configured and built on first use)
#   --hardened                 own suite: compile the tests with -DYCXX_HARDENED=1 (the library's
#                              run-time precondition checks) and run the death tests of
#                              tests/ycxx/precondition (YCXX_HARDENED=1)
#   --cxxflags FLAGS           own suite: append FLAGS to every test's compile flags, e.g.
#                              "-fno-exceptions" or -O2 (YCXX_CXXFLAGS)
#   --config-name NAME         the short name of those flags in log and report names
#                              (default: made from the flags; YCXX_CONFIG_NAME)
#   -x, --fail-fast            stop at the first failing step
#   -v, --verbose              stream every command's output; print every test's transcript
#   -q, --quiet                suites: list only the tests that did not pass
#   --no-fetch                 do not download a missing external suite (YCXX_NO_FETCH=1);
#                              by default tools/fetch-suites fetches it into the cache first
#   -h, --help
#
# Ctrl-C stops the run gracefully: the step or suite running is cut short (a suite keeps the
# results of the tests that ran, and writes its logs and report), the remaining steps are listed as
# skipped, and the summary and composite report are made as usual. Exit status 130.
#
# At the end: build/test-logs/run.html, the composite report of the run (every stage and suite,
# every failure in full, copy buttons, the whole report as Markdown in run.md), to share.
#
# Compilers come from the YCXX_* variables (tools/toolchain/activate.sh), else from the
# toolchains.env written by tools/toolchain/provision, else g++-16 / clang++-23. lit runs through
# uvx (YCXX_LIT overrides; tools/lib/env.sh). Logs: build/test-logs/.
set -eu
repo=$(cd "$(dirname "$0")/.." && pwd)
cd "$repo"
. "$repo/tools/lib/ui.sh"
. "$repo/tools/lib/env.sh"

invocation="tools/test $(ui_quote "$@")"
started=$(date -u +%Y-%m-%dT%H:%M:%SZ)

usage() { sed -n '2,/^set -eu/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; }

compilers= filters= jobs= sanitizer= fail_fast=0 stages=
while [ $# -gt 0 ]; do
  case $1 in
    -c|--compiler) compilers="$compilers $2"; shift ;;
    -f|--filter) filters="$filters $2"; shift ;;
    -j|--jobs) jobs=$2; shift ;;
    -j*) jobs=${1#-j} ;;
    -s|--sanitizer) sanitizer=$2; shift ;;
    --hardened) YCXX_HARDENED=1; export YCXX_HARDENED ;;
    --cxxflags) YCXX_CXXFLAGS=$2; export YCXX_CXXFLAGS; shift ;;
    --cxxflags=*) YCXX_CXXFLAGS=${1#--cxxflags=}; export YCXX_CXXFLAGS ;;
    --config-name) YCXX_CONFIG_NAME=$2; export YCXX_CONFIG_NAME; shift ;;
    --config-name=*) YCXX_CONFIG_NAME=${1#--config-name=}; export YCXX_CONFIG_NAME ;;
    -x|--fail-fast) fail_fast=1 ;;
    -v|--verbose) YCXX_VERBOSE=1; export YCXX_VERBOSE ;;
    -q|--quiet) YCXX_QUIET=1; export YCXX_QUIET ;;
    --no-fetch) YCXX_NO_FETCH=1 ;;
    -h|--help) usage; exit 0 ;;
    all) stages="policy build freestanding cmake ycxx libcxx libstdcxx" ;;
    policy|build|freestanding|cmake|ycxx|libcxx|libstdcxx) stages="$stages $1" ;;
    *) echo "tools/test: unknown option or stage '$1' (tools/test --help)" >&2; exit 2 ;;
  esac
  shift
done
compilers=${compilers:-gcc clang}
stages=${stages:-policy build freestanding ycxx}
for c in $compilers; do
  case $c in gcc|clang) ;; *) echo "tools/test: unknown compiler '$c'" >&2; exit 2 ;; esac
done

ycxx_env_load
ycxx_suite_dirs
SANITIZER=$sanitizer
export SANITIZER
ycxx_run_config || exit 2
if [ "${YCXX_HARDENED:-0}" = 1 ] || [ -n "${ycxx_config_name}" ]; then
  case " $stages " in *" libcxx "*|*" libstdcxx "*)
    echo "tools/test: --hardened, --cxxflags and --config-name apply to the own suite (ycxx) only" >&2
    exit 2 ;;
  esac
fi
logs=$repo/build/test-logs
mkdir -p "$logs"
results=$logs/summary.txt
: >"$results"
: >"$logs/.run-start"
t_start=$(date +%s)
ui_catch_interrupt
broken= # compilers whose library did not build: their suites are skipped

# record STATUS LABEL SECONDS-OR-REASON [LOG] [COMMAND] [REPORT]: one line of $results, fields
# separated by the ASCII unit separator (an empty field survives `read`, unlike with a tab).
us=$(printf '\037')
record() { printf '%s\037%s\037%s\037%s\037%s\037%s\n' "$1" "$2" "$3" "${4:-}" "${5:-}" "${6:-}" >>"$results"; }

# not_run LABEL: after Ctrl-C, the steps that follow are listed as skipped, not run (true then).
not_run() {
  [ "${ui_interrupted}" = 1 ] || return 1
  ui_skip "$1" "(not run: interrupted)"
  record skip "$1" "(not run: interrupted)"
}

# step LABEL LOGNAME CMD...: one recorded step, its output in build/test-logs/LOGNAME.log.
step() {
  s_label=$1 s_log=$logs/$2.log
  shift 2
  ! not_run "$s_label" || return 1
  s_t0=$(date +%s)
  if ui_step "$s_label" "$s_log" "$@"; then
    record ok "$s_label" $(($(date +%s) - s_t0)) "$s_log" "$(ui_quote "$@")"
  elif [ "${ui_interrupted}" = 1 ]; then
    record interrupted "$s_label" $(($(date +%s) - s_t0)) "$s_log" "$(ui_quote "$@")"
    return 1
  else
    record FAIL "$s_label" $(($(date +%s) - s_t0)) "$s_log" "$(ui_quote "$@")"
    finish_if_fail_fast
    return 1
  fi
}

# direct LABEL LOGNAME REPORT CMD...: one recorded step whose command prints its own progress.
# With a LOGNAME its output is also kept in build/test-logs/LOGNAME.log (through tee, so the
# command keeps colour but not a tty); REPORT names the HTML report the command writes.
direct() {
  d_label=$1 d_log=${2:+$logs/$2.log} d_report=$3
  shift 3
  ! not_run "$d_label" || return 1
  d_t0=$(date +%s)
  ui_cmd "$@"
  if [ -n "$d_log" ]; then
    d_sf=$d_log.status
    # tee ignores Ctrl-C, so that it keeps what the interrupted command prints while stopping.
    { set +e; YCXX_COLOR=$([ -n "${ui_reset}" ] && echo always || echo never) "$@" 2>&1; echo $? >"$d_sf"; } |
      (trap '' INT; exec tee "$d_log")
    d_st=$(cat "$d_sf" 2>/dev/null || echo 1); rm -f "$d_sf"
  else
    d_st=0; "$@" || d_st=$?
  fi
  if [ "$d_st" = 0 ]; then
    record ok "$d_label" $(($(date +%s) - d_t0)) "$d_log" "$(ui_quote "$@")" "$d_report"
  elif [ "${ui_interrupted}" = 1 ]; then
    record interrupted "$d_label" $(($(date +%s) - d_t0)) "$d_log" "$(ui_quote "$@")" "$d_report"
    return 1
  else
    record FAIL "$d_label" $(($(date +%s) - d_t0)) "$d_log" "$(ui_quote "$@")" "$d_report"
    ui_failed=1
    finish_if_fail_fast
    return 1
  fi
}

finish_if_fail_fast() {
  if [ $fail_fast = 1 ]; then summary; exit 1; fi
}

cxx_of() { if [ "$1" = gcc ]; then echo "${YCXX_GXX:-g++-16}"; else echo "${YCXX_CLANGXX:-clang++-23}"; fi; }
cc_of() { if [ "$1" = gcc ]; then echo "${YCXX_GCC:-gcc-16}"; else echo "${YCXX_CLANG:-clang-23}"; fi; }

summary() {
  ui_title "Summary"
  nok=0 nfail=0 nskip=0 nint=0
  # The third field is a duration in seconds, or for a skipped step the reason.
  while IFS=$us read -r st label extra _; do
    case $st in
      ok) ui_ok "$label" "($(ui_duration "$extra"))"; nok=$((nok + 1)) ;;
      skip) ui_skip "$label" "$extra"; nskip=$((nskip + 1)) ;;
      interrupted) ui_warn "$label" "(interrupted after $(ui_duration "$extra"))"; nint=$((nint + 1)) ;;
      *) ui_fail "$label" "($(ui_duration "$extra"))"; nfail=$((nfail + 1)) ;;
    esac
  done <"$results"
  total=$(ui_duration $(($(date +%s) - t_start)))
  echo
  if [ "${ui_interrupted}" = 1 ]; then
    printf '  %s%s interrupted (Ctrl-C)%s after %s: %d passed, %d failed, %d cut short, %d skipped or not run;\n' \
      "${ui_yellow}${ui_bold}" "${ui_sym_warn}" "${ui_reset}" "$total" "$nok" "$nfail" "$nint" "$nskip"
    printf '  what ran is kept in the logs and reports, in %s\n' "$logs"
  elif [ $nfail = 0 ]; then
    printf '  %s%s %d step%s passed%s in %s; logs in %s\n' "${ui_green}${ui_bold}" "${ui_sym_ok}" "$nok" \
      "$([ $nok = 1 ] || echo s)" \
      "${ui_reset}" "$total" "$logs"
  else
    printf '  %s%s %d of %d steps failed%s in %s; logs in %s\n' "${ui_red}${ui_bold}" "${ui_sym_fail}" "$nfail" \
      $((nok + nfail)) "${ui_reset}" "$total" "$logs"
  fi
  [ $nskip = 0 ] || [ "${ui_interrupted}" = 1 ] || printf '  %s%d skipped%s\n' "${ui_yellow}" "$nskip" "${ui_reset}"
  # The reports of the suites run now: every test, how it was run and what it printed.
  reports=$(find "$logs" -name '*.html' -newer "$logs/.run-start" ! -name run.html 2>/dev/null | sort)
  if [ -n "$reports" ]; then
    echo
    printf '  %sTest reports (every test with its commands, exit statuses and output):%s\n' "${ui_bold}" "${ui_reset}"
    for r in $reports; do ui_info "$r"; done
  fi
  # The composite report of the run: every stage and every suite in one page, every failure in
  # full (tools/lib/run_report.py).
  commit=$(git -C "$repo" rev-parse --short=12 HEAD 2>/dev/null || echo unknown)
  dirty=$(git -C "$repo" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
  [ "$dirty" = 0 ] || commit="$commit (+$dirty uncommitted changes)"
  set --
  for c in $compilers; do set -- "$@" "$c=$($(cxx_of $c) --version 2>/dev/null | head -n 1)"; done
  [ "${ui_interrupted}" = 0 ] || set -- "$@" "interrupted=yes (Ctrl-C): the steps after it were not run"
  if python3 "$repo/tools/lib/run_report.py" "$results" "$logs/run" "command=$invocation" "started=$started" \
       "commit=$commit" "host=$(uname -srm)" "$@" "logs=$logs"; then
    echo
    printf '  %sComposite report%s (every stage and suite, every failure in full; share it, or use its\n' "${ui_bold}" "${ui_reset}"
    printf '  "Copy for an agent" button; as Markdown: %s):\n' "$logs/run.md"
    ui_info "$logs/run.html"
  fi
}

ui_title "libycxx tests: $(echo $stages)"
ui_info "repository" "$repo"
ui_info "platform" "$(uname -s) $(uname -m)"
for c in $compilers; do
  v=$($(cxx_of $c) --version 2>/dev/null | head -n 1) || v="not found"
  ui_info "$c" "$(cxx_of $c): $v"
done
[ -n "${ycxx_env_file:-}" ] && ui_info "toolchains" "${ycxx_env_file}"
case " $stages " in *" ycxx "*|*" libcxx "*|*" libstdcxx "*)
  if ycxx_lit_cmd 2>/dev/null; then ui_info "lit" "${ycxx_lit}"
  else ui_warn "lit" "not found: install uv (https://docs.astral.sh/uv/) or set YCXX_LIT"; fi ;;
esac

for stage in $stages; do
  case $stage in
    policy)
      ui_section "Policy checks"
      step "preprocessor policy" policy-preprocessor python3 tools/check_preprocessor.py || :
      step "include layering" policy-includes python3 tools/check_includes.py || :
      step "hidden visibility of the library namespaces" policy-visibility python3 tools/check_visibility.py || :
      step "shell portability (bash 3.2, dash)" policy-shell python3 tools/check_shell.py || :
      # [macro.names]: the headers spell no name a program may #define (DECISIONS §2).
      step "reserved names only in the headers" policy-names python3 tools/uglify.py --check || :
      # The export lists of the modules std and std.compat are read from the headers by both
      # compilers (Clang's AST, GCC's reflection): stale when a header adds or removes a name.
      step "std modules up to date with the headers" policy-std-modules python3 tools/gen_std_module.py --check || :
      ;;
    build)
      for c in $compilers; do
        ui_section "Build with $c"
        for t in RelWithDebInfo Release; do
          d=build/$c; [ $t = Release ] && d=build/$c-release
          if [ ! -f $d/build.ninja ]; then
            step "$c $t: configure ($d)" build-$c-$t-configure cmake -S . -B $d -G Ninja \
              -DCMAKE_C_COMPILER="$(cc_of $c)" -DCMAKE_CXX_COMPILER="$(cxx_of $c)" -DCMAKE_BUILD_TYPE=$t ||
              { [ $t = Release ] || broken="$broken $c"; continue; }
          fi
          step "$c $t: build ($d)" build-$c-$t ninja -C $d ${jobs:+-j$jobs} ||
            { [ $t = Release ] || broken="$broken $c"; }
        done
      done
      ;;
    freestanding)
      direct "freestanding headers, bare-metal smoke link" freestanding "" tools/check_freestanding.sh || :
      ;;
    cmake)
      direct "CMake package and toolchain file" cmake "" tests/cmake/run.sh $compilers || :
      ;;
    ycxx|libcxx|libstdcxx)
      for c in $compilers; do
        label="$stage suite, $c${sanitizer:+, $sanitizer}"
        [ "${YCXX_HARDENED:-0}" = 1 ] && label="$label, hardened"
        label=$label${ycxx_config_name:+, ${ycxx_config_name}}
        ! not_run "$label" || continue
        case " $broken " in *" $c "*)
          ui_section "$label"; ui_skip "$label" "(the $c build failed)"
          record skip "$label" "(the $c build failed)"; continue ;;
        esac
        if [ ! -f build/$c/libycxx.a ]; then
          ui_section "$label"; ui_skip "$label" "(build/$c/libycxx.a missing: run the build stage)"
          record skip "$label" "(no build/$c/libycxx.a)"; continue
        fi
        case $stage in
          libcxx) dir=$ycxx_libcxx_tests ;;
          libstdcxx) dir=$ycxx_libstdcxx_tests ;;
          *) dir=tests/ycxx ;;
        esac
        # A missing external suite is fetched on demand into the cache (once; later runs use
        # it), unless LIBCXX_TESTS / LIBSTDCXX_TESTS names a directory of the user's.
        case $stage in libcxx) chosen=${LIBCXX_TESTS:-} ;; libstdcxx) chosen=${LIBSTDCXX_TESTS:-} ;; *) chosen= ;; esac
        if [ ! -d "$dir" ] && [ "$stage" != ycxx ] && [ -z "$chosen" ] && [ "${YCXX_NO_FETCH:-0}" != 1 ]; then
          ui_section "Fetch the $stage tests (not found at $dir)"
          step "fetch the $stage tests (tools/fetch-suites --$stage-only)" fetch-$stage \
            tools/fetch-suites --$stage-only || :
          ycxx_suite_dirs
          case $stage in libcxx) dir=$ycxx_libcxx_tests ;; libstdcxx) dir=$ycxx_libstdcxx_tests ;; esac
        fi
        if [ ! -d "$dir" ]; then
          ui_section "$label"; ui_skip "$label" "($dir not found: run tools/fetch-suites)"
          record skip "$label" "($dir not found: run tools/fetch-suites)"; continue
        fi
        run=$stage-$c${ycxx_run_suffix}
        direct "$label" "" "$logs/$run.html" tools/run-conformance $stage $c $filters -- ${jobs:+-j$jobs} || :
      done
      ;;
  esac
done

summary
# The exit status: 130 after Ctrl-C, else 1 when any step failed (a suite step fails when any of
# its tests does).
[ "${ui_interrupted}" = 0 ] || exit 130
if grep -q "^FAIL$us" "$results"; then exit 1; fi
exit 0
