# range-v3: the ranges library std::ranges came from (an implementation of a standard proposal:
# its implementation sources are not read; its tests and build files are). Heavy template
# metaprogramming and concepts over the standard library's iterators and containers.
url = https://github.com/ericniebler/range-v3.git
ref = 0.12.0
commit = a81477931a8aa2ad025c6bda0609f38e09e4d7ec
exercises = ranges, iterators, concepts, templates
# Its tests build with -Werror and -march=native: off (C++26 deprecates its literal operators'
# spelling, "operator "" _z").
configure = -DRANGE_V3_TESTS=ON -DRANGE_V3_EXAMPLES=OFF -DRANGE_V3_PERF=OFF -DRANGE_V3_DOCS=OFF -DRANGES_CXX_STD=20 -DRANGES_ENABLE_WERROR=OFF -DRANGES_NATIVE=OFF
