// -*- C++ -*-  libycxx: <initializer_list>   [core]
#pragma once

#include <ycxx/config.hpp>
#include <ycxx/core/cstddef.hpp>
#include <ycxx/core/version.hpp>

// In plain std (DECISIONS §20.5): GCC deduces `auto` from a braced list, and a range-for over one,
// only with ::std::initializer_list.
namespace [[__gnu__::__visibility__("hidden")]] std { // plain std (DECISIONS §20.5)

// Layout {pointer, size} is what both GCC and Clang construct for braced-init-lists.
template <class _Ep>
class initializer_list {
  const _Ep* __first_;
  size_t __size_;

  // Called by the compiler.
  constexpr initializer_list(const _Ep* b, size_t n) noexcept : __first_(b), __size_(n) {}

public:
  using value_type = _Ep;
  using reference = const _Ep&;
  using const_reference = const _Ep&;
  using size_type = size_t;
  using iterator = const _Ep*;
  using const_iterator = const _Ep*;

  constexpr initializer_list() noexcept : __first_(nullptr), __size_(0) {}

  constexpr const _Ep* data() const noexcept { return __first_; }
  constexpr size_t size() const noexcept { return __size_; }
  constexpr const _Ep* begin() const noexcept { return __first_; }
  constexpr const _Ep* end() const noexcept { return __first_ + __size_; }
  [[nodiscard]] constexpr bool empty() const noexcept { return __size_ == 0; }
};

} // namespace std

